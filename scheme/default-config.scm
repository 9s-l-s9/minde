;; Complete portable keymap, read as data. No external programs are assumed.
(minde-config
 (version 1)
 (prefix (ctrl) "t")
 ;; Immediately ends the session without asking applications to save.
 (emergency-exit (ctrl alt) "BackSpace")
 (global-bindings)
 (bindings
  ("h" (call move-focus! ((direction . left))) "focus frame")
  ("j" (call move-focus! ((direction . down))) "focus frame")
  ("k" (call move-focus! ((direction . up))) "focus frame")
  ("l" (call move-focus! ((direction . right))) "focus frame")
  ("n" focus-next-window!)
  ("p" pull-hidden-next!)
  ("0" (call select-window-by-number! ((number . 0))))
  ("1" (call select-window-by-number! ((number . 1))))
  ("2" (call select-window-by-number! ((number . 2))))
  ("3" (call select-window-by-number! ((number . 3))))
  ("4" (call select-window-by-number! ((number . 4))))
  ("5" (call select-window-by-number! ((number . 5))))
  ("6" (call select-window-by-number! ((number . 6))))
  ("7" (call select-window-by-number! ((number . 7))))
  ("8" (call select-window-by-number! ((number . 8))))
  ("9" (call select-window-by-number! ((number . 9))))
  ("Return" run-prompt!)
  ("r" run-prompt!)
  ("space" command-palette!)
  ("colon" eval-prompt!)
  ("w" (keymap
    (description "window commands") (enter show-windows!)
    (bindings
     ("n" focus-next-window!) ("p" focus-previous-window!)
     ("c" close-current-window!) ("f" float-this!) ("w" windowlist!)
     ("u" (keymap (description "pull hidden window")
       (bindings ("n" pull-hidden-next!) ("p" pull-hidden-previous!))))
     ("h" (call move-window! ((direction . left))) "move window")
     ("j" (call move-window! ((direction . down))) "move window")
     ("k" (call move-window! ((direction . up))) "move window")
     ("l" (call move-window! ((direction . right))) "move window")
     ("0" (call pull-window-by-number! ((number . 0))) "pull window 0")
     ("1" (call pull-window-by-number! ((number . 1))) "pull window 1")
     ("2" (call pull-window-by-number! ((number . 2))) "pull window 2")
     ("3" (call pull-window-by-number! ((number . 3))) "pull window 3")
     ("4" (call pull-window-by-number! ((number . 4))) "pull window 4")
     ("5" (call pull-window-by-number! ((number . 5))) "pull window 5")
     ("6" (call pull-window-by-number! ((number . 6))) "pull window 6")
     ("7" (call pull-window-by-number! ((number . 7))) "pull window 7")
     ("8" (call pull-window-by-number! ((number . 8))) "pull window 8")
     ("9" (call pull-window-by-number! ((number . 9))) "pull window 9"))))
  ("x" (keymap (description "exchange windows")
    (bindings
     ("h" (call exchange-windows! ((direction . left))) "exchange left")
     ("j" (call exchange-windows! ((direction . down))) "exchange down")
     ("k" (call exchange-windows! ((direction . up))) "exchange up")
     ("l" (call exchange-windows! ((direction . right))) "exchange right"))))
  ("f" (keymap (description "frame commands") (enter show-frame-labels!)
    (bindings
     ("h" split-frame-horizontal!) ("v" split-frame-vertical!)
     ("c" remove-split!) ("o" collapse-to-one-frame!) ("e" clear-current-frame!)
     ("0" (call focus-frame-by-index! ((index . 0))) "select frame 0")
     ("1" (call focus-frame-by-index! ((index . 1))) "select frame 1")
     ("2" (call focus-frame-by-index! ((index . 2))) "select frame 2")
     ("3" (call focus-frame-by-index! ((index . 3))) "select frame 3")
     ("4" (call focus-frame-by-index! ((index . 4))) "select frame 4")
     ("5" (call focus-frame-by-index! ((index . 5))) "select frame 5")
     ("6" (call focus-frame-by-index! ((index . 6))) "select frame 6")
     ("7" (call focus-frame-by-index! ((index . 7))) "select frame 7")
     ("8" (call focus-frame-by-index! ((index . 8))) "select frame 8")
     ("9" (call focus-frame-by-index! ((index . 9))) "select frame 9"))))
  ("g" (keymap (description "group commands")
    (bindings
     ("n" switch-to-next-group!) ("p" switch-to-previous-group!)
     ("o" switch-to-last-group!) ("s" gselect!)
     ("m" move-current-window-to-next-group-and-follow!))))
  ("o" (keymap (description "output (monitor) commands")
    (bindings
     ("n" focus-next-head!) ("p" focus-previous-head!) ("o" focus-last-head!)
     ("s" (call set-head-mode! ((mode . span))) "span heads (one tree over all monitors)")
     ("h" (call set-head-mode! ((mode . per-head))) "per-head mode (a tree per monitor)"))))
  ("m" (keymap (description "layout and mode commands")
    (bindings ("l" layout-prompt!) ("r" enter-resize-mode!) ("c" command-mode!))))
  ("s" (keymap (description "session commands")
    (bindings
     ("r" reload-configuration!) ("l" lock-screen!)
     ("z" suspend!) ("q" logout!))))))
