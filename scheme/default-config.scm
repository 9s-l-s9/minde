;; Dependency-light portable defaults. Personal prefixes and launchers belong
;; in ~/.config/minde/.
(minde-config
 (version 1)
 (prefix (ctrl) "t")
 ;; Immediately ends the session without asking applications to save.
 (emergency-exit (ctrl alt) "BackSpace")
 (bindings))
