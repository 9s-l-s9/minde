   ((name . wm-pointer-position) (signature . "(wm-pointer-position)") (documentation . "Return the pointer position as (X Y) in global logical coordinates."))
   ((name . wm-window-geometry) (signature . "(wm-window-geometry id)") (documentation . "Return visible window ID's global logical (X Y WIDTH HEIGHT), or #f."))
