   ((name . wm-paste) (signature . "(wm-paste)") (documentation . "Send Ctrl+V to the focused surface using the synthetic key queue."))
   ((name . wm-scroll) (signature . "(wm-scroll dx dy)") (documentation . "Scroll DX/DY wheel notches (1 = one wheel click) at the current pointer position; sends discrete value120 plus continuous values."))
   ((name . wm-screenshot) (signature . "(wm-screenshot path [window-id])") (documentation . "Write a deferred PNG of the output under the pointer (or WINDOW-ID's region) to absolute PATH; returns an automation token, completion via wm-automation-status."))
   ((name . wm-warp-pointer-relative) (signature . "(wm-warp-pointer-relative dx dy)") (documentation . "Warp the pointer by a relative delta DX,DY."))
   ((name . wm-set-key-repeat) (signature . "(wm-set-key-repeat spec)") (documentation . "Configure keyboard repeat rate and delay from SPEC."))
   ((name . wm-idle-ms) (signature . "(wm-idle-ms)") (documentation . "Return milliseconds elapsed since the last input event."))
   ((name . wm-input-devices) (signature . "(wm-input-devices)") (documentation . "Return ((name cap ...) ...): the present libinput devices."))
   ((name . wm-configure-input-rule!) (signature . "(wm-configure-input-rule! match key value kind flag)") (documentation . "Low-level libinput rule primitive wrapped by wm-configure-input!."))
   ((name . wm-session-locked?) (signature . "(wm-session-locked?)") (documentation . "Return whether the session is currently locked."))
   ((name . wm-publish-event) (signature . "(wm-publish-event line)") (documentation . "Mirror one serialized event LINE to every event-socket subscriber."))
   ((name . wm-events-active?) (signature . "(wm-events-active?)") (documentation . "Return whether any event-socket subscriber is connected."))
   ((name . wm-drop-files) (signature . "(wm-drop-files x y paths)") (documentation . "Schedule a native Wayland copy drop of absolute regular-file PATHS and return its token or #f."))
   ((name . wm-drop-text) (signature . "(wm-drop-text x y text)") (documentation . "Schedule a native Wayland plain-text copy drop and return its token or #f."))
