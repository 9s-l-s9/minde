  (hooks
   ((name . new-window) (arguments id title app-id) (documentation . "A window was mapped and placed."))
   ((name . destroy-window) (arguments id) (documentation . "A window was unmapped."))
   ((name . focus-window) (arguments id) (documentation . "The shown window changed (ID or #f)."))
   ((name . focus-frame) (arguments x y w h) (documentation . "The current frame changed."))
   ((name . focus-group) (arguments name) (documentation . "The focused group switched."))
   ((name . message) (arguments text) (documentation . "Something was echoed to the user."))
   ((name . session-lock) (arguments) (documentation . "The session-lock surface came up."))
   ((name . session-unlock) (arguments) (documentation . "The session-lock surface went away."))
   ((name . automation-result) (arguments token operation status) (documentation . "An asynchronous automation request reached a terminal status.")))
