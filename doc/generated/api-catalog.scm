   ((name . create-floating-group!) (module minde groups) (signature . "(create-floating-group! arg-1)") (documentation . "Creates a new float group and switches to it (StumpWM gnew-float)."))
   ((name . create-floating-group-in-background!) (module minde groups) (signature . "(create-floating-group-in-background! arg-1)") (documentation . "Creates a new float group in the background (StumpWM gnewbg-float):\nevery window mapped while it is current floats automatically. Does not\nswitch to it."))
   ((name . create-group!) (module minde groups) (signature . "(create-group! arg-1)") (documentation . "Creates a new empty group named NAME and switches to it (StumpWM\ngnew)."))
   ((name . create-group-in-background!) (module minde groups) (signature . "(create-group-in-background! arg-1)") (documentation . "Creates a new empty group named NAME (a string), appended to the end of\n%groups, sized to the last known output geometry. Does not switch to it\n(StumpWM gnewbg). Rejects blank or duplicate names before changing state;\nsurrounding whitespace is ignored when checking uniqueness."))
   ((name . current-group-name) (module minde groups) (signature . "(current-group-name)") (documentation . "Returns the padded name of the active group."))
   ((name . current-layout-status) (module minde groups) (signature . "(current-layout-status)") (documentation . "Returns a stable description of the current group/head layout.\nDynamic layouts return (dynamic POSITION RATIO); manual layouts return\n(manual SPEC), where SPEC is the public frame-tree layout datum."))
   ((name . delete-current-group!) (module minde groups) (signature . "(delete-current-group!)") (documentation . "Deletes the current group; its windows move to the next group, which\nbecomes current, wrapping from the last group to the first (StumpWM gkill).\nA no-op with one group."))
   ((name . delete-other-groups!) (module minde groups) (signature . "(delete-other-groups!)") (documentation . "Deletes every group except the current one, merging all their windows\ninto it (StumpWM gkill-other)."))
   ((name . dump-desktop) (module minde groups) (signature . "(dump-desktop)") (documentation . "Returns the versioned running-session desktop snapshot datum."))
   ((name . dump-desktop-to-file) (module minde groups) (signature . "(dump-desktop-to-file arg-1)") (documentation . "Writes the running-session desktop snapshot to PATH and echoes the result."))
   ((name . dynamic-group?) (module minde groups) (signature . "(dynamic-group? [opt-1])") (documentation . "Returns true when G is managed by the dynamic master/stack policy."))
   ((name . exchange-with-master!) (module minde groups) (signature . "(exchange-with-master!)") (documentation . "Swaps the focused window with the master (StumpWM\nexchange-with-master). Does nothing unless focus belongs to the current\nhead's tiled order."))
   ((name . focus-next-head!) (module minde groups) (signature . "(focus-next-head!)") (documentation . ""))
   ((name . focus-previous-head!) (module minde groups) (signature . "(focus-previous-head!)") (documentation . "Focuses the previous output head in display order."))
   ((name . forget!) (module minde groups) (signature . "(forget!)") (documentation . "Drops every placement rule matching the focused window and persists\n(StumpWM forget)."))
   ((name . group-has-window?) (module minde groups) (signature . "(group-has-window? arg-1 arg-2)") (documentation . "Returns true when group NAME contains window ID in a tree or float list."))
   ((name . group-names) (module minde groups) (signature . "(group-names)") (documentation . "Returns every group name in switching order."))
   ((name . group-status-summaries) (module minde groups) (signature . "(group-status-summaries)") (documentation . "Returns stable status tuples for every group.\nEach tuple is (NAME FOCUSED? WINDOW-COUNT FLOATING? DYNAMIC?)."))
   ((name . groups-echo-string) (module minde groups) (signature . "(groups-echo-string)") (documentation . "The group list one per line with window counts, the current group\nmarked * (StumpWM groups/vgroups)."))
   ((name . handle-foreign-activate!) (module minde groups) (signature . "(handle-foreign-activate! arg-1)") (documentation . "Rust: a taskbar requests activation. Validate ID before changing groups."))
   ((name . handle-heads-change!) (module minde groups) (signature . "(handle-heads-change! arg-1)") (documentation . "Multi-head backends report the full usable-rect list here:\n((id x y w h) ...)."))
   ((name . handle-keyboard-layout-changed!) (module minde groups) (signature . "(handle-keyboard-layout-changed! arg-1)") (documentation . "Rust: the active keyboard layout group is now NAME (a string such as\n\"English (US)\") -- after `set-keyboard-layout!' or an XKB toggle option\nlike grp:win_space_toggle. The default shows NAME through the message\noverlay; redefine it to update a bar or stay silent."))
   ((name . handle-output-configure-failed!) (module minde groups) (signature . "(handle-output-configure-failed! arg-1 arg-2)") (documentation . "Rust: a `configure-output!' request for the head NAME was rejected\nfor REASON (a string). The default logs it through `wm-log'."))
   ((name . handle-output-configured!) (module minde groups) (signature . "(handle-output-configured!)") (documentation . "Rust: the output layout was just changed -- by an external\nwlr-output-management client or by `configure-output!'. The default\ndoes nothing; redefine it to re-tile, persist or log. The head model\nhas already been reflowed through `handle-heads-change!' by the time\nthis runs."))
   ((name . handle-output-geometry!) (module minde groups) (signature . "(handle-output-geometry! arg-1 arg-2 arg-3 arg-4)") (documentation . "Single-head compatibility path (old binaries / winit-era configs)."))
   ((name . handle-window-fullscreen!) (module minde groups) (signature . "(handle-window-fullscreen! arg-1 arg-2)") (documentation . "Rust: an application requests fullscreen for ID without taking focus.\nRecords hidden-group requests for the next activation; unknown IDs do nothing."))
   ((name . handle-window-map!) (module minde groups) (signature . "(handle-window-map! arg-1 arg-2 arg-3)") (documentation . "Places a newly mapped window, applies locked rules, and retiles if dynamic."))
   ((name . handle-window-move!) (module minde groups) (signature . "(handle-window-move! arg-1 arg-2 arg-3 arg-4 arg-5)") (documentation . "Rust reports the final geometry of a super+drag move/resize."))
   ((name . handle-window-title-change!) (module minde groups) (signature . "(handle-window-title-change! arg-1 arg-2 arg-3)") (documentation . "Rust: a mapped toplevel's title/app-id changed. Refreshes bookkeeping\n(windowlist, remapped keys, rules, status line). If the app-id was empty\nat the first buffer commit, apply any locked placement rule when it\nfirst becomes known."))
   ((name . handle-window-unmap!) (module minde groups) (signature . "(handle-window-unmap! arg-1)") (documentation . "Removes ID from whichever group's tree currently holds it -- the active\ngroup first (which re-syncs), then every hidden group (which doesn't need\na sync since nothing hidden is on-screen)."))
   ((name . keyboard-layouts) (module minde groups) (signature . "(keyboard-layouts)") (documentation . "The XKB layout groups of the seat keyboard, in keymap order, as a list\nof alists ((name . \"German (Bone)\") (active . #t)). Groups come from\nXKB_DEFAULT_LAYOUT (comma separated) at startup; a single-layout keymap\ngives one entry. Returns '() without a compositor."))
   ((name . kill-windows-current-group!) (module minde groups) (signature . "(kill-windows-current-group!)") (documentation . "Politely closes every window of the current group (StumpWM\nkill-windows-current-group)."))
   ((name . kill-windows-other!) (module minde groups) (signature . "(kill-windows-other!)") (documentation . "Politely closes every window of every group except the current one\n(StumpWM kill-windows-other)."))
   ((name . load-placement-rules!) (module minde groups) (signature . "(load-placement-rules!)") (documentation . "Loads fully validated rules, migrating version 1 and deduplicating.\nMigration uses exact app-id matches with title fallback only without an\napp-id. The file is upgraded to version 2 on the next successful save.\nMissing files are ignored. Invalid files preserve memory and block saves\nuntil a successful reload or removal. Returns #t on success."))
   ((name . mark-dynamic!) (module minde groups) (signature . "(mark-dynamic! arg-1)") (documentation . "Marks G dynamic and creates its empty per-head policy table."))
   ((name . merge-group-into-current!) (module minde groups) (signature . "(merge-group-into-current! arg-1)") (documentation . "Merges the group named NAME-OR-INDEX into the current one: all its\nwindows (floats stay floating) move here and the emptied group is\ndeleted (StumpWM gmerge)."))
   ((name . move-current-window-to-next-group-and-follow!) (module minde groups) (signature . "(move-current-window-to-next-group-and-follow!)") (documentation . "Moves the current window to the next group and switches there with it\n(StumpWM gmove-and-follow)."))
   ((name . move-marked-windows-to-group!) (module minde groups) (signature . "(move-marked-windows-to-group! arg-1)") (documentation . "Moves every marked window of the current group into the given group\nand clears their marks (StumpWM gmove-marked)."))
   ((name . move-window-to-next-group!) (module minde groups) (signature . "(move-window-to-next-group!)") (documentation . "Moves the current group's current window into the next group's current\nframe, and hides it (it leaves the screen; the current group stays\ncurrent -- this does not follow the window). A no-op if there's only one\ngroup or the current frame has no window."))
   ((name . next-urgent!) (module minde groups) (signature . "(next-urgent!)") (documentation . "Jumps to the oldest urgent window (StumpWM next-urgent), switching to\nits group if needed."))
   ((name . output-configuration-allowed?) (module minde groups) (signature . "(output-configuration-allowed?)") (documentation . "Policy predicate consulted before an external wlr-output-management\nclient (wlr-randr, kanshi, shikane, wdisplays) may test or apply an\noutput configuration. The default accepts everything; redefine it in\nyour init file to return #f (or gate on your own state) to refuse\nexternal changes. `configure-output!' does not consult it."))
   ((name . output-heads) (module minde groups) (signature . "(output-heads)") (documentation . "Every known output head, disabled ones included, as a list of alists:\n((name . \"DP-1\") (enabled . #t) (make . \"DEL\") (model . \"U2723QE\")\n (serial . \"ABC\") (description . \"DEL U2723QE ABC\")\n (mode . (3840 2160 60000)) (preferred-mode . (3840 2160 60000))\n (position . (1920 0)) (scale . 1.5) (transform . normal)\n (adaptive-sync . #f) (modes . ((3840 2160 60000) ...))).\nModes are (width height refresh-mhz); MODE and PREFERRED-MODE are #f\nwhen unknown; ADAPTIVE-SYNC is #t, #f or the symbol `unsupported'.\nUnlike `wm-outputs' (enabled heads' usable rectangles, keyed by the\ncompositor's head id) this is the raw per-connector view a\nwlr-output-management client sees. Returns '() without a compositor."))
   ((name . place-existing-windows!) (module minde groups) (signature . "(place-existing-windows!)") (documentation . "Re-applies the placement rules to every already-mapped window of the\nactive group (StumpWM place-existing-windows). Floats keep floating and\nare left alone; a window already in its rule's target frame stays put.\nFloat rules and floating target groups float matching tiled windows.\nAffected dynamic groups retile every head immediately."))
   ((name . remember!) (module minde groups) (signature . "(remember!)") (documentation . "Pins the focused window's exact app-id to its current group and frame.\nRefuses windows without an app-id instead of remembering a transient title."))
   ((name . rename-current-group!) (module minde groups) (signature . "(rename-current-group! arg-1)") (documentation . "Renames the current group (StumpWM grename). Group names are stored\npadded (\" I \"); NAME is padded the same way. Rejects another group's name,\nignoring surrounding whitespace. Blank input leaves the name unchanged."))
   ((name . restore-from-file) (module minde groups) (signature . "(restore-from-file arg-1)") (documentation . "Re-applies a dump-desktop file: groups are matched (or created) by\nname, their frame layouts and window assignments restored, float\ngeometries re-applied. Groups not in the dump are left alone. The whole\nfile is validated first; a malformed one changes nothing."))
   ((name . retile-dynamic!) (module minde groups) (signature . "(retile-dynamic!)") (documentation . "Recomputes the current head's master/stack tiling for the current\ngroup: windows that appeared since the last retile become the master\n(newest first), vanished ones drop out. Preserves the selected tiled\nwindow when it survives, otherwise selects the master. No-op in a manual group."))
   ((name . retile-dynamic-group!) (module minde groups) (signature . "(retile-dynamic-group!)") (documentation . "Forces a retile of the current dynamic group's head (StumpWM\nretile)."))
   ((name . rotate-stack!) (module minde groups) (signature . "(rotate-stack! [opt-1])") (documentation . "Rotates only the stack windows, master stays (StumpWM rotate-stack)."))
   ((name . rotate-windows!) (module minde groups) (signature . "(rotate-windows! [opt-1])") (documentation . "Rotates all windows through the master/stack positions (StumpWM\nrotate-windows)."))
   ((name . save-placement-rules!) (module minde groups) (signature . "(save-placement-rules!)") (documentation . "Writes deduplicated placement rules atomically. Returns #f on failure,\npreserving unreadable files and leaving the in-memory rules unchanged."))
   ((name . set-head-mode!) (module minde groups) (signature . "(set-head-mode! arg-1)") (documentation . "'per-head (a frame tree per monitor, StumpWM style) or 'span (one\ntree over the union of all monitors)."))
   ((name . set-keyboard-layout!) (module minde groups) (signature . "(set-keyboard-layout! arg-1)") (documentation . "Activate a keyboard layout group. SPEC is a zero-based index into\n`keyboard-layouts', the symbol `next' or `prev' (cycling with wrap-around),\nor a string matched case-insensitively as a prefix of a group's name\n(\"English\" selects \"English (US)\"). The switch is queued to the\ncompositor, which tells the focused client through the normal modifiers\nevent; `handle-keyboard-layout-changed!' then runs with the new name.\nReturns #t once queued, #f without a compositor or for an unknown name;\na malformed SPEC raises."))
   ((name . shift-current-window-to-next-group!) (module minde groups) (signature . "(shift-current-window-to-next-group!)") (documentation . "Moves the current window to the next group and follows it (StumpWM\ngnext-with-window)."))
   ((name . shift-current-window-to-previous-group!) (module minde groups) (signature . "(shift-current-window-to-previous-group!)") (documentation . "Moves the current window to the previous group and follows it (StumpWM\ngprev-with-window)."))
   ((name . status-line) (module minde groups) (signature . "(status-line)") (documentation . "Returns the compatibility one-line group and focused-window status."))
   ((name . switch-to-group!) (module minde groups) (signature . "(switch-to-group! arg-1)") (documentation . "Switches to the group named NAME-OR-INDEX (a string), at that index\n(0-based), or supplied as a live group record. No-op for an unknown name,\nout-of-range index or deleted group record, or when the group is already\ncurrent. Parks every window of the outgoing group off-screen, then\nactivates the target group and syncs it (placing its windows, restoring\nor clearing focus)."))
   ((name . switch-to-last-group!) (module minde groups) (signature . "(switch-to-last-group!)") (documentation . "Toggles back to the previously current group."))
   ((name . switch-to-next-group!) (module minde groups) (signature . "(switch-to-next-group!)") (documentation . "Switches to the next group in %groups, wrapping around."))
   ((name . switch-to-previous-group!) (module minde groups) (signature . "(switch-to-previous-group!)") (documentation . "Switches to the previous group in %groups, wrapping around."))
   ((name . wm-on-session-lock) (module minde groups) (signature . "(wm-on-session-lock)") (documentation . "Rust: the session-lock surface is up and the session is now locked.\nCancels frame selection and runs the 'session-lock hook."))
   ((name . wm-on-session-lock-lost) (module minde groups) (signature . "(wm-on-session-lock-lost)") (documentation . "Rust: the lock owner disappeared; the session remains locked.\nRuns the 'session-lock-lost hook once for that owner."))
   ((name . wm-on-session-unlock) (module minde groups) (signature . "(wm-on-session-unlock)") (documentation . "Rust: the session-lock surface was torn down; the session is\nunlocked again. Runs the 'session-unlock hook."))
   ((name . apply-layout!) (module minde layouts) (signature . "(apply-layout! arg-1)") (documentation . "Rebuilds the current head's frame tree from the layout named NAME,\nredistributing its tiled windows (see apply-layout-spec!). Floats and\nother heads are unchanged. Echoes an error for an unknown name."))
   ((name . define-layout!) (module minde layouts) (signature . "(define-layout! arg-1 arg-2)") (documentation . "Registers configuration layout NAME as SPEC, taking precedence over\nsame-named saved layouts on load. Does not persist; see save-layout!."))
   ((name . layout-names) (module minde layouts) (signature . "(layout-names)") (documentation . "Returns registered layout names in stable insertion order."))
   ((name . layout-spec) (module minde layouts) (signature . "(layout-spec arg-1)") (documentation . "Returns the frame-tree specification registered as NAME, or #f."))
   ((name . load-layouts!) (module minde layouts) (signature . "(load-layouts!)") (documentation . "Loads validated saved layouts; configuration-defined names take precedence.\nMissing files are ignored. Invalid files leave the registry unchanged and\nblock saves until a successful reload or removal. Returns #t on success."))
   ((name . save-layout!) (module minde layouts) (signature . "(save-layout! arg-1)") (documentation . "Saves the live frame tree as NAME, preserving previously saved layouts.\nOther configuration presets are not copied into the file. A name that the\nconfiguration defines is refused: its definition replaces any saved layout\nof that name on every load. Returns #f on refusal or failure without\nchanging the registry or overwriting an unreadable file."))
   ((name . configure-prompt-ui!) (module minde input) (signature . "(configure-prompt-ui!)") (documentation . "Inject display and clipboard operations. Omitted operations keep their\ncurrent value, allowing this module to run without a compositor."))
   ((name . input-abort!) (module minde input) (signature . "(input-abort!)") (documentation . "Closes the active prompt and invokes its optional abort callback."))
   ((name . input-active?) (module minde input) (signature . "(input-active?)") (documentation . "Returns true while a one-line input prompt owns keyboard input."))
   ((name . input-handle-key!) (module minde input) (signature . "(input-handle-key! arg-1 arg-2 arg-3)") (documentation . "Handles one keypress while a prompt is active. Always consumes (#t)."))
   ((name . input-paste!) (module minde input) (signature . "(input-paste! arg-1)") (documentation . "Inserts TEXT (clipboard contents delivered async by Rust via\nhandle-paste!) at point. No-op if the prompt closed in the meantime;\nnewlines collapse to spaces since the prompt is a single line."))
   ((name . key-notation) (module minde input) (signature . "(key-notation arg-1 arg-2)") (documentation . "Returns canonical C-/M-/S-/s- notation for MODIFIERS and KEY."))
   ((name . lookup-key) (module minde input) (signature . "(lookup-key arg-1 arg-2 arg-3)") (documentation . "Returns the value registered for MODIFIERS and KEY, or #f."))
   ((name . make-key-registry) (module minde input) (signature . "(make-key-registry)") (documentation . "Returns an empty collision-detecting key registry."))
   ((name . modifier->bit) (module minde input) (signature . "(modifier->bit arg-1)") (documentation . "Returns the compositor bit assigned to MODIFIER; errors on unknown names."))
   ((name . modifiers->bitmask) (module minde input) (signature . "(modifiers->bitmask arg-1)") (documentation . "Returns canonical modifier bits, collapsing repeated names and aliases."))
   ((name . read-one-line) (module minde input) (signature . "(read-one-line arg-1 arg-2)") (documentation . "Prompts for a line of input in the message overlay. ON-SUBMIT is\ncalled with the entered string on RET; ON-ABORT (if given) on C-g/ESC.\nCOMPLETIONS is a list of strings or a thunk returning one (TAB cycles\nprefix matches). HISTORY names the history list (C-p/C-n)."))
   ((name . register-key!) (module minde input) (signature . "(register-key! arg-1 arg-2 arg-3 arg-4)") (documentation . "Registers VALUE under MODIFIERS and KEY; errors on a duplicate notation."))
   ((name . registered-keys) (module minde input) (signature . "(registered-keys arg-1)") (documentation . "Returns REGISTRY entries as canonical-notation/value pairs."))
   ((name . capabilities) (module minde commands) (signature . "(capabilities)") (documentation . "Return the versioned command schema capabilities and concise action list."))
   ((name . clear-command-registry!) (module minde commands) (signature . "(clear-command-registry!)") (documentation . "Removes every command from the process-local registry."))
   ((name . command-arguments) (module minde commands) (signature . "command-arguments") (documentation . ""))
   ((name . command-category) (module minde commands) (signature . "command-category") (documentation . ""))
   ((name . command-completion) (module minde commands) (signature . "command-completion") (documentation . ""))
   ((name . command-demo-id) (module minde commands) (signature . "command-demo-id") (documentation . ""))
   ((name . command-documentation) (module minde commands) (signature . "command-documentation") (documentation . ""))
   ((name . command-effects) (module minde commands) (signature . "command-effects") (documentation . ""))
   ((name . command-examples) (module minde commands) (signature . "command-examples") (documentation . ""))
   ((name . command-name) (module minde commands) (signature . "command-name") (documentation . ""))
   ((name . command-names) (module minde commands) (signature . "(command-names)") (documentation . "Returns every registered command name in lexical order."))
   ((name . command-parameters) (module minde commands) (signature . "command-parameters") (documentation . ""))
   ((name . command-preconditions) (module minde commands) (signature . "command-preconditions") (documentation . ""))
   ((name . command-procedure) (module minde commands) (signature . "command-procedure") (documentation . ""))
   ((name . command-ref) (module minde commands) (signature . "(command-ref arg-1)") (documentation . "Returns the registered command named NAME, or #f."))
   ((name . command-result-schema) (module minde commands) (signature . "command-result-schema") (documentation . ""))
   ((name . command-retry) (module minde commands) (signature . "command-retry") (documentation . ""))
   ((name . command-scope) (module minde commands) (signature . "command-scope") (documentation . ""))
   ((name . command-summary) (module minde commands) (signature . "command-summary") (documentation . ""))
   ((name . command-typed?) (module minde commands) (signature . "(command-typed? arg-1)") (documentation . "Whether COMMAND declares typed named parameters, including an empty list."))
   ((name . command?) (module minde commands) (signature . "command?") (documentation . ""))
   ((name . commands-in-category) (module minde commands) (signature . "(commands-in-category arg-1)") (documentation . "Returns registered command records whose category is CATEGORY."))
   ((name . describe-action) (module minde commands) (signature . "(describe-action arg-1)") (documentation . "Return NAME's full readable command contract, or #f if unregistered.\nMissing legacy metadata is explicitly unknown; PARAMETERS is #f for legacy\ncommands. EXAMPLES are Scheme call data, never strings to evaluate."))
   ((name . invoke-command) (module minde commands) (signature . "(invoke-command arg-1 ...)") (documentation . "Invoke NAME positionally; typed commands validate all supplied values and\nfill omitted trailing defaults before calling their procedure."))
   ((name . invoke-command/named) (module minde commands) (signature . "(invoke-command/named arg-1 arg-2)") (documentation . "Invoke NAME with a validated named ARGUMENTS alist and applied defaults."))
   ((name . register-command!) (module minde commands) (signature . "(register-command! arg-1 arg-2)") (documentation . "Register a command. PARAMETERS is #f for legacy positional commands, or a\nlist of named schemas. Each schema has name/type and optional required,\ndefault, enum, minimum, maximum, min-length, max-length, and description.\nAn optional parameter must have a valid default. Typed parameters determine\nargument order. Other metadata is readable data; unknown means undeclared."))
   ((name . schema-value-valid?) (module minde commands) (signature . "(schema-value-valid? arg-1 arg-2)") (documentation . "Whether VALUE is bounded readable data matching TYPE. Primitive types are\nany, boolean, integer (exact), number (finite real), string, symbol, list,\nand alist (unique symbol keys). Compound types are (enum VALUE ...),\n(maybe TYPE), accepting #f, and (list-of TYPE)."))
   ((name . search-actions) (module minde commands) (signature . "(search-actions [opt-1])") (documentation . "Return concise action summaries matching QUERY in name, category, or\nsummary, case-insensitively. Empty QUERY returns all registered actions."))
   ((name . validate-command-arguments) (module minde commands) (signature . "(validate-command-arguments arg-1 arg-2)") (documentation . "Validate a named ARGUMENTS alist and return values in procedure order,\nincluding defaults. No procedure is called. Failure throws\ncommand-validation-error with stable CODE and readable DETAILS. Legacy\ncommands require their declared argument names but cannot validate types."))
   ((name . add-event-hook!) (module minde hooks) (signature . "(add-event-hook! arg-1 arg-2)") (documentation . "Registers PROC to run when hook NAME fires."))
   ((name . event-hook-procedures) (module minde hooks) (signature . "(event-hook-procedures arg-1)") (documentation . "Returns the compositor event-hook procedures registered for NAME."))
   ((name . remove-event-hook!) (module minde hooks) (signature . "(remove-event-hook! arg-1 arg-2)") (documentation . "Removes PROC from compositor event hook NAME."))
   ((name . run-event-hook!) (module minde hooks) (signature . "(run-event-hook! arg-1 ...)") (documentation . "Runs every procedure registered on NAME with ARGS; errors are logged\nvia the wm-log subr (when present) and swallowed."))
   ((name . current-state) (module minde status) (signature . "(current-state)") (documentation . "Returns the schema-versioned compositor state as an alist.\nWhen REDACT? is true, window titles and application identifiers are omitted."))
   ((name . current-state-json) (module minde status) (signature . "(current-state-json)") (documentation . "Returns the current compositor state as one compact schema-v1 JSON object."))
   ((name . current-status-text) (module minde status) (signature . "(current-status-text)") (documentation . "Returns a one-line summary suitable for an external bar such as eww."))
   ((name . publish-status!) (module minde status) (signature . "(publish-status!)") (documentation . "Atomically publishes status.json and the compatibility text status file.\nUnchanged compositor state is not rewritten after a successful publication;\nthe sequence advances per change even when several changes coalesce into one\nwrite. Failed writes remain pending for the next publication, which retries\nwithout advancing the sequence unless the state changed. Errors are\nlogged and swallowed so a missing runtime directory cannot interrupt window\nmanagement. Before any output is configured there is nothing meaningful to\nreport (and no head geometry to describe), so the call returns immediately\nwithout building the state body or touching the sequence number; the sync\nhook's own state build only ever runs after the first output exists."))
   ((name . status-file-path) (module minde status) (signature . "(status-file-path)") (documentation . "Returns the path of the atomically published structured status file."))
   ((name . status-schema-version) (module minde status) (signature . "status-schema-version") (documentation . ""))
   ((name . action-status) (module minde control) (signature . "(action-status arg-1)") (documentation . "Returns a stored action result, refreshing asynchronous completion.\nAn expired receipt or missing automation token reports outcome-unknown."))
   ((name . desktop-snapshot) (module minde control) (signature . "(desktop-snapshot)") (documentation . "Returns schema-v1 desktop facts across all groups, a session epoch,\nrevision, and event cursor. Objects are alists; collections are vectors.\nNull denotes unavailable information. Locking forces content redaction."))
   ((name . events-since) (module minde control) (signature . "(events-since arg-1)") (documentation . "Returns sequenced journal events or an explicit resynchronization gap.\nQuery-time lock redaction also applies to events recorded before locking."))
   ((name . new-action-request) (module minde control) (signature . "(new-action-request)") (documentation . "Allocates a server-issued receipt ID and returns session/revision preconditions.\nThe last 256 allocations are retained. Older IDs remain recognizably expired;\nthey cannot execute again. Allocate before transmitting a retryable action."))
   ((name . note-desktop-change!) (module minde control) (signature . "(note-desktop-change! ...)") (documentation . "Invalidates observed revisions after a policy synchronization or event.\nThis counter also detects a supported change followed by its inverse."))
   ((name . perform-action!) (module minde control) (signature . "(perform-action! arg-1 arg-2)") (documentation . "Validates and executes a typed action, returning a versioned receipt.\nUse new-action-request before sending if transport retries are needed. Raw\neval remains separate. Rejected requests consume their receipt too. A request\nthat cannot fit a bounded fingerprint stays observably rejected; subsequent\nsubmissions with its ID conflict, so inspect action-status for that rejection.\nThis procedure never waits or silently retries."))
   ((name . register-control-commands!) (module minde control) (signature . "(register-control-commands!)") (documentation . "Registers the typed desktop control surface in the ordinary command registry.\nLoading this module has no compositor side effects; call after legacy setup.")))
  (gsubrs
   ((name . wm-spawn) (signature . "(wm-spawn command)") (documentation . "Spawn a child process on the main thread with WAYLAND_DISPLAY set."))
   ((name . wm-quit) (signature . "(wm-quit)") (documentation . "Quit the compositor and stop the event loop."))
   ((name . wm-set-emergency-exit) (signature . "(wm-set-emergency-exit mods keysym-name)") (documentation . "Set the native emergency exit chord with modifier mask MODS (shift=1, ctrl=4, alt=8, super=64) and an XKB key name; #f #f disables it. Returns #f without changes on invalid input. Works before startup and bypasses Scheme, lock and shortcut-inhibit policy."))
   ((name . wm-log) (signature . "(wm-log message)") (documentation . "Append MESSAGE to the compositor log."))
   ((name . wm-version) (signature . "(wm-version)") (documentation . "Return the running binary's version and build revision, exactly as minde --version prints it."))
   ((name . wm-place-window) (signature . "(wm-place-window id x y w h)") (documentation . "Move and size the tiled window ID to the given rectangle."))
   ((name . wm-focus-window) (signature . "(wm-focus-window id)") (documentation . "Give keyboard focus to the window ID."))
   ((name . wm-close-window) (signature . "(wm-close-window id)") (documentation . "Politely request the client of window ID to close it."))
   ((name . wm-clear-focus) (signature . "(wm-clear-focus)") (documentation . "Drop keyboard focus so no window is focused."))
   ((name . wm-message) (signature . "(wm-message text [timeout-ms])") (documentation . "Show an on-screen message, optionally auto-clearing after TIMEOUT-MS."))
   ((name . wm-clear-message) (signature . "(wm-clear-message)") (documentation . "Remove the current on-screen message."))
   ((name . wm-add-overlay) (signature . "(wm-add-overlay x y text)") (documentation . "Add a positioned text overlay at output coordinates X,Y."))
   ((name . wm-clear-overlays) (signature . "(wm-clear-overlays)") (documentation . "Remove every text overlay."))
   ((name . wm-border-color) (signature . "(wm-border-color hex)") (documentation . "Set the focus-border color from a \"#rrggbb\" string."))
   ((name . wm-configure-appearance!) (signature . "(wm-configure-appearance! settings)") (documentation . "Apply an alist of border-width, background, message-font-size, message-padding, message-border-width, message-foreground, message-background and message-border-color. Sizes are logical pixels; colors are #rrggbb strings. Reject invalid or duplicate settings with #f and no changes; omitted fields retain their values."))
   ((name . wm-focus-rect) (signature . "(wm-focus-rect x y w h)") (documentation . "Draw the focus rectangle at the given geometry."))
   ((name . wm-output-geometry) (signature . "(wm-output-geometry)") (documentation . "Return the primary output usable rectangle."))
   ((name . wm-run-after-ms) (signature . "(wm-run-after-ms ms token)") (documentation . "Run the callback stored under TOKEN after MS milliseconds."))
   ((name . wm-set-fullscreen) (signature . "(wm-set-fullscreen id fullscreen?)") (documentation . "Set whether window ID is fullscreen."))
   ((name . wm-kill-window) (signature . "(wm-kill-window id)") (documentation . "Forcibly terminate the client owning window ID."))
   ((name . wm-warp-pointer) (signature . "(wm-warp-pointer x y)") (documentation . "Warp the pointer to global logical output coordinates X,Y."))
   ((name . wm-pointer-position) (signature . "(wm-pointer-position)") (documentation . "Return the pointer position as (X Y) in global logical coordinates."))
   ((name . wm-window-geometry) (signature . "(wm-window-geometry id)") (documentation . "Return visible window ID's global logical (X Y WIDTH HEIGHT), or #f."))
   ((name . wm-request-paste) (signature . "(wm-request-paste)") (documentation . "Read CLIPBOARD asynchronously and deliver it to minde's active prompt."))
   ((name . wm-outputs) (signature . "(wm-outputs)") (documentation . "Return ((id x y w h name) ...): every output's usable rectangle."))
   ((name . wm-output-heads) (signature . "(wm-output-heads)") (documentation . "Return one alist per known head (disabled too): name, enabled, make, model, serial, description, mode, preferred-mode, position, scale, transform, adaptive-sync, modes."))
   ((name . wm-configure-output!) (signature . "(wm-configure-output! name alist)") (documentation . "Queue an output change for head NAME from an alist of mode/position/scale/transform/enabled/adaptive-sync; wrapped by configure-output!."))
   ((name . wm-keyboard-layouts) (signature . "(wm-keyboard-layouts)") (documentation . "Return one ((name . \"...\") (active . bool)) alist per XKB layout group of the seat keyboard; wrapped by keyboard-layouts."))
   ((name . wm-set-keyboard-layout!) (signature . "(wm-set-keyboard-layout! spec)") (documentation . "Queue a switch of the active XKB layout group; SPEC is an index or the symbol next/prev; wrapped by set-keyboard-layout!."))
   ((name . wm-runtime-info) (signature . "(wm-runtime-info)") (documentation . "Return (backend xwayland-status xdisplay uptime-ms)."))
   ((name . wm-control-ready?) (signature . "(wm-control-ready?)") (documentation . "Return whether this is the compositor Guile thread with live state outside nested Rust command application; controlled actions require this context."))
   ((name . wm-set-clipboard) (signature . "(wm-set-clipboard text)") (documentation . "Set the Wayland CLIPBOARD selection contents to TEXT."))
   ((name . wm-set-primary) (signature . "(wm-set-primary text)") (documentation . "Set the Wayland PRIMARY (middle-click) selection contents to TEXT."))
   ((name . wm-place-float) (signature . "(wm-place-float id x y w h)") (documentation . "Move and size the floating window ID to the given rectangle."))
   ((name . wm-window-title) (signature . "(wm-window-title id)") (documentation . "The (title . app-id) pair the client set on window ID, or #f."))
   ((name . wm-geometry-revision) (signature . "(wm-geometry-revision)") (documentation . "Monotonic process-local epoch for changes in committed window geometry, including changes reverted between snapshot reads."))
   ((name . wm-transient-ids) (signature . "(wm-transient-ids)") (documentation . "Return transient window IDs from Wayland parent and X11 transient hints."))
   ((name . wm-floating-ids) (signature . "(wm-floating-ids)") (documentation . "The window ids the compositor currently treats as floating."))
   ((name . wm-timing-stats) (signature . "(wm-timing-stats)") (documentation . "Per-probe (name count total-us max-us buckets) timing of command application, key dispatch, rendering, layer arrangement, capture work and connector scans."))
   ((name . wm-timing-slow) (signature . "(wm-timing-slow)") (documentation . "The most recent samples that exceeded one 60 Hz frame, oldest first, as (name us age-ms context); the context names the bound key, command or output and never contains typed text."))
   ((name . wm-place-windows) (signature . "(wm-place-windows placements)") (documentation . "Apply a whole layout at once: PLACEMENTS is a list of (id x y w h) tiled or (id x y w h #f) float entries; returns the ids of unknown windows."))
   ((name . wm-raise-window) (signature . "(wm-raise-window id)") (documentation . "Raise window ID to the top of the stack."))
   ((name . wm-set-floating) (signature . "(wm-set-floating id floating?)") (documentation . "Set whether window ID floats above the tiling layout."))
   ((name . wm-send-string) (signature . "(wm-send-string text [delay-ms])") (documentation . "Type TEXT through paced synthetic key events (20 ms between characters by default). Unmapped characters use a temporary client keymap without changing the clipboard."))
   ((name . wm-type) (signature . "(wm-type text [delay-ms])") (documentation . "Alias of wm-send-string: type TEXT through paced key events, using a temporary client keymap for unmapped characters without changing the clipboard."))
   ((name . wm-click) (signature . "(wm-click button [count])") (documentation . "Click BUTTON COUNT times after a hover/settle motion; accepts left/middle/right symbols, 1/2/3, or evdev codes."))
   ((name . wm-send-key) (signature . "(wm-send-key mods keysym-name)") (documentation . "Synthesize a paced key press/release with modifier mask MODS; Enter aliases Return."))
   ((name . wm-paste) (signature . "(wm-paste)") (documentation . "Send Ctrl+V to the focused surface using the synthetic key queue."))
   ((name . wm-scroll) (signature . "(wm-scroll dx dy)") (documentation . "Scroll DX/DY wheel notches (1 = one wheel click) at the current pointer position; sends discrete value120 plus continuous values."))
   ((name . wm-screenshot) (signature . "(wm-screenshot path [window-id])") (documentation . "Publish a new PNG below wm-screenshot-directory; reject symlinks, traversal and existing files. The complete file appears atomically. Untargeted capture uses the pointer output; WINDOW-ID uses its greatest-overlap output and full rectangle at that output's scale, without stitching. Offscreen targets fail asynchronously. Returns a token or #f; completion via wm-automation-status."))
   ((name . wm-screenshot-directory) (signature . "(wm-screenshot-directory)") (documentation . "The absolute screenshot directory: MINDE_SCREENSHOT_DIR or the private runtime directory's minde/screenshots child. Returns #f for invalid configuration."))
   ((name . wm-warp-pointer-relative) (signature . "(wm-warp-pointer-relative dx dy)") (documentation . "Warp the pointer by a relative delta DX,DY."))
   ((name . wm-set-key-repeat) (signature . "(wm-set-key-repeat enabled?)") (documentation . "Enable or disable compositor-side repeat for keys consumed by a prompt or keymap. This does not change client repeat settings."))
   ((name . wm-set-keyboard-repeat!) (signature . "(wm-set-keyboard-repeat! rate delay-ms)") (documentation . "Set shared client and compositor repeat timing: exact integer rate 0-1000 Hz and delay 0-10000 ms. Rate 0 disables repeat. Stops any active compositor repeat; the next press uses the new settings. Invalid arguments return #f without changes."))
   ((name . wm-idle-ms) (signature . "(wm-idle-ms)") (documentation . "Return monotonic milliseconds since input or session resume, counting from startup."))
   ((name . wm-input-devices) (signature . "(wm-input-devices)") (documentation . "Return ((name cap ...) ...): the present libinput devices."))
   ((name . wm-configure-input-rule!) (signature . "(wm-configure-input-rule! match tap natural accel click output [options])") (documentation . "Low-level input rule primitive wrapped by wm-configure-input!. OUTPUT is a connector name, an empty string for automatic association, or #f to omit it. Optional OPTIONS is an alist with accel-speed, scroll-method, scroll-button, left-handed, disable-while-typing and middle-emulation. Invalid options return #f without replacing the rule."))
   ((name . wm-session-lock-confirmed?) (signature . "(wm-session-lock-confirmed?)") (documentation . "Whether the locked session has passed its output presentation barrier; safe to suspend."))
   ((name . wm-session-locked?) (signature . "(wm-session-locked?)") (documentation . "Return whether the session is currently locked."))
   ((name . wm-session-lock-abandoned?) (signature . "(wm-session-lock-abandoned?)") (documentation . "Return whether the session remains locked without a live owner; false as soon as a replacement takes ownership."))
   ((name . wm-publish-event) (signature . "(wm-publish-event line)") (documentation . "Mirror one serialized event LINE to every event-socket subscriber."))
   ((name . wm-events-active?) (signature . "(wm-events-active?)") (documentation . "Return whether any event-socket subscriber is connected."))
   ((name . wm-event-cursor) (signature . "(wm-event-cursor)") (documentation . "Return the current journal sequence, including events published without listeners."))
   ((name . wm-events-since) (signature . "(wm-events-since cursor)") (documentation . "Return ((sequence . N) (gap . BOOL) (events . ((SEQ LINE) ...))). A gap means CURSOR is stale or in the future; resnapshot. The journal has finite count and byte bounds."))
   ((name . wm-drop-files) (signature . "(wm-drop-files x y paths)") (documentation . "Schedule a native Wayland copy drop of absolute regular-file PATHS and return its token or #f."))
   ((name . wm-drop-text) (signature . "(wm-drop-text x y text)") (documentation . "Schedule a native Wayland plain-text copy drop and return its token or #f."))
   ((name . wm-automation-status) (signature . "(wm-automation-status token)") (documentation . "Return (OPERATION STATUS) for a recent asynchronous automation token, or #f.")))
  (hooks
   ((name . new-window) (arguments id title app-id) (documentation . "A window was mapped and placed."))
   ((name . window-title-changed) (arguments id title app-id) (documentation . "A mapped window changed its title or application identifier."))
   ((name . window-geometry) (arguments id rectangle) (documentation . "Native journal event: committed window geometry changed; RECTANGLE is (x y width height), or #f for a hidden or unavailable window."))
   ((name . destroy-window) (arguments id) (documentation . "A window was unmapped."))
   ((name . focus-window) (arguments id) (documentation . "The shown window changed (ID or #f)."))
   ((name . urgent-window) (arguments id) (documentation . "A window requested attention."))
   ((name . focus-frame) (arguments x y w h) (documentation . "The current frame changed."))
   ((name . focus-group) (arguments name) (documentation . "The focused group switched."))
   ((name . message) (arguments text) (documentation . "Something was echoed to the user."))
   ((name . session-lock) (arguments) (documentation . "The session-lock surface came up."))
   ((name . session-lock-lost) (arguments) (documentation . "The lock owner disappeared; the session remains locked."))
   ((name . session-unlock) (arguments) (documentation . "The session-lock surface went away."))
   ((name . automation-result) (arguments token operation status) (documentation . "An asynchronous automation request reached a terminal status.")))
