;; Minimal eww bar for minde. Copy this directory to ~/.config/eww
;; (or merge into your config) and run:  eww open bar
;;
;; The bar is a layer-shell surface with an exclusive zone, so minde
;; automatically shrinks the frame tree underneath it -- windows never
;; overlap the bar.
;;
;; minde writes its status line ("[I]  II  III | window title") to
;; $XDG_RUNTIME_DIR/minde-status whenever it changes; tail -F turns
;; that into a live eww variable. (Polling alternative:
;;   :interval "1s"  `minde-cmd '(status-line)'` )

(deflisten minde-status
  :initial "…"
  "tail -F ${XDG_RUNTIME_DIR:-/tmp}/minde-status 2>/dev/null")

(defpoll clock :interval "10s" "date '+%a %d %b  %H:%M'")

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  (centerbox
    (box :halign "start" :class "status" minde-status)
    (box)
    (box :halign "end" :class "clock" clock)))
