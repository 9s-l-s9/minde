;;; Real Unix socket and PTY exchanges, without a compositor.
(use-modules (ice-9 match) (ice-9 textual-ports) (ice-9 binary-ports)
             (rnrs bytevectors) (system foreign) (srfi srfi-1) (srfi srfi-64)
             (minde agent))
(test-begin "control-cli")
(define (contents path) (call-with-input-file path get-string-all))
(define (read-datums path)
  (call-with-input-file path (lambda (p) (let loop ((out '()))
    (let ((value (read p))) (if (eof-object? value) (reverse out) (loop (cons value out))))))))
(define (deadline) (+ (get-internal-real-time) (* 6 internal-time-units-per-second)))
(define (expired? end) (> (get-internal-real-time) end))
(define (open-pty)
  (let* ((master (make-bytevector 4)) (slave (make-bytevector 4))
         (openpty (pointer->procedure int (dynamic-func "openpty" (dynamic-link))
                                    (list '* '* '* '* '*))))
    (unless (zero? (openpty (bytevector->pointer master) (bytevector->pointer slave)
                           %null-pointer %null-pointer %null-pointer))
      (error "openpty failed"))
    (cons (bytevector-s32-native-ref master 0) (bytevector-s32-native-ref slave 0))))
(define* (run-client arguments replies #:key (input "") (interactive? #f))
  (let* ((directory (mkdtemp (string-copy "/tmp/minde-cli-XXXXXX")))
         (socket-path (string-append directory "/minde-ipc.sock"))
         (listener (socket AF_UNIX SOCK_STREAM 0))
         (requests (string-append directory "/requests"))
         (output (string-append directory "/stdout"))
         (errors (string-append directory "/stderr"))
         (stdin (string-append directory "/stdin"))
         (server #f) (child #f) (pty #f) (master #f))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (bind listener AF_UNIX socket-path)
        (listen listener 8)
        (call-with-output-file stdin (lambda (p) (display input p)))
        (force-output)
        (set! server (primitive-fork))
        (when (zero? server)
          (sigaction SIGPIPE SIG_IGN)
          (catch #t
            (lambda ()
              (call-with-output-file requests
                (lambda (p)
                  (for-each
                   (lambda (reply)
                     (unless (pair? (car (select (list listener) '() '() 4)))
                       (error "missing CLI connection"))
                     (let* ((connection (car (accept listener))) (text (get-string-all connection)))
                       (write text p) (newline p) (force-output p)
                       (when (pair? reply) (usleep (cdr reply)))
                       (false-if-exception (display (if (pair? reply) (car reply) reply) connection))
                       (false-if-exception (force-output connection))
                       (false-if-exception (close-port connection)))) replies)))
              (primitive-exit 0))
            (lambda _ (primitive-exit 1))))
        (when interactive? (set! pty (open-pty)))
        (set! child (primitive-fork))
        (when (zero? child)
          (close-port listener)
          (setenv "XDG_RUNTIME_DIR" directory)
          (setenv "XDG_STATE_HOME" directory)
          (setenv "GUILE_AUTO_COMPILE" "0")
          (let ((in (open-input-file stdin)) (out (open-output-file output)) (err (open-output-file errors)))
            (dup2 (if pty (cdr pty) (fileno in)) 0)
            (dup2 (if pty (cdr pty) (fileno out)) 1)
            (dup2 (fileno err) 2)
            (when pty (close-fdes (car pty)) (close-fdes (cdr pty)))
            (apply execlp "timeout" "timeout" "--signal=KILL" "8" "sh" "scripts/mindectl" arguments)))
        (let* ((status
                (if (not interactive?) (cdr (waitpid child))
                    (begin
                      (close-fdes (cdr pty))
                      (set! master (fdopen (car pty) "r+"))
                      (setvbuf master 'none)
                      (let ((end (deadline)) (text "") (sent? #f)
                            (buffer (make-bytevector 8192))
                            (read-fd (pointer->procedure ssize_t (dynamic-func "read" (dynamic-link))
                                                        (list int '* size_t))))
                        (let loop ()
                          (when (expired? end) (error "interactive CLI deadline"))
                          (when (pair? (car (select (list master) '() '() 0 50000)))
                            (let ((n (read-fd (fileno master) (bytevector->pointer buffer) 8192)))
                              (when (> n 0)
                                (let ((part (make-bytevector n)))
                                  (bytevector-copy! buffer 0 part 0 n)
                                  (set! text (string-append text (utf8->string part)))))))
                          (when (and (not sent?) (string-contains text "minde> "))
                            (display input master) (force-output master) (set! sent? #t))
                          (let ((done (waitpid child WNOHANG)))
                            (if (zero? (car done)) (loop)
                                (begin
                                  (test-assert "interactive prompt" sent?)
                                  (call-with-output-file output (lambda (p) (display text p)))
                                  (cdr done)))))))))
               (server-status (cdr (waitpid server))))
          (set! child #f) (set! server #f)
          (test-equal "all expected exchanges arrived" 0 (status:exit-val server-status))
          (when interactive?
            (let ((history (string-append directory "/minde/repl-history")))
              (test-equal "history is private" #o600 (stat:perms (stat history)))
              (test-assert "completion recorded" (string-contains (contents history) "focus-window!"))))
          (vector (status:exit-val status) (contents output) (contents errors) (read-datums requests))))
      (lambda ()
        (for-each (lambda (pid) (when pid (false-if-exception (kill pid SIGKILL)) (false-if-exception (waitpid pid))))
                  (list child server))
        (when master (close-port master))
        (close-port listener)
        (system* "rm" "-rf" "--" directory)))))
(define (json result) (load-json (vector-ref result 1)))
(define (sent result) (vector-ref result 3))
(let* ((directory (mkdtemp (string-copy "/tmp/minde-config-cli-XXXXXX")))
       (file (string-append directory "/candidate\".scm"))
       (datum '(minde-config (version 1) (prefix () "Print")
                            (bindings ("d" desktop-snapshot) ("w" windows)))))
  (define (save datum) (call-with-output-file file (lambda (p) (write datum p))))
  (dynamic-wind
    (lambda () #t)
    (lambda ()
      (save datum)
      (let ((result (run-client (list "check-config" file) '())))
        (test-equal "offline control bindings accepted" 0 (vector-ref result 0))
        (test-equal "offline validation needs no session" '() (sent result))
        (test-equal "human configuration success" (string-append "configuration valid: " file "\n")
          (vector-ref result 1)))
      (let ((result (run-client (list "check-config" file "--live" "--scheme") '("(ok #t)"))))
        (test-equal "live validation success" 0 (vector-ref result 0))
        (test-equal "live validation serializes quoted data"
          `(begin ((@ (minde config) validate-configuration) ',datum) #t)
          (call-with-input-string (car (sent result)) read)))
      (for-each
       (lambda (command)
         (save `(minde-config (version 1) (prefix (ctrl) "t") (bindings ("d" ,command))))
         (let ((result (run-client (list "check-config" file "--json") '())))
           (test-equal "invalid offline binding exit" 1 (vector-ref result 0))
           (test-equal "offline error code" "invalid-configuration"
             (ref (ref (json result) "error") "code"))))
       '(personal-noop! focus-window!))
      (for-each
       (lambda (keys)
         (save `(minde-config (version 1) (prefix (ctrl) "t")
                              (bindings ,@(map (lambda (key) (list key 'windows)) keys))))
         (test-equal "CLI rejects invalid or duplicate canonical keys" 1
           (vector-ref (run-client (list "check-config" file) '()) 0)))
       '(("Space") ("M-C-g" "C-M-g") ("Prior" "Page_Up")))
      (save '(minde-config (version 1) (prefix () "Page_Up") (bindings ("M-C-g" windows))))
      (test-equal "CLI accepts aliases and reordered modifiers" 0
        (vector-ref (run-client (list "check-config" file) '()) 0))
      (save '(minde-config (version 1) (prefix () "Pritn") (bindings)))
      (test-equal "CLI rejects unknown prefix keys" 1
        (vector-ref (run-client (list "check-config" file) '()) 0))
      (let ((result (run-client (list "check-config" file "--live" "--scheme")
                               '("(error misc-error () \"requires arguments\" \"\")"))))
        (test-equal "live validation failure exit" 1 (vector-ref result 0)))
      (let ((result (run-client (list "check-config" file "--live" "--json") '(""))))
        (test-equal "live validation transport exit" 3 (vector-ref result 0)))
      (call-with-output-file file (lambda (p) (display "#.(error \"executed\")" p)))
      (let ((result (run-client (list "check-config" file "--live") '())))
        (test-equal "reader evaluation rejected locally" 1 (vector-ref result 0))
        (test-equal "invalid data never sent" '() (sent result)))
      (test-equal "live option restricted to configuration checking" 2
        (vector-ref (run-client '("eval" "#t" "--live") '()) 0))
      (test-equal "configuration requires a file" 2
        (vector-ref (run-client '("check-config" "--live") '()) 0)))
    (lambda () (system* "rm" "-rf" "--" directory))))
(define (has text part) (and (string-contains text part) #t))
(let ((result (run-client '("eval" "(list \"#< λ\" 1)") '("(ok (\"#< λ\" 1))"))))
  (test-equal "legacy success" 0 (vector-ref result 0))
  (test-equal "legacy Unicode" "(\"#< λ\" 1)\n" (vector-ref result 1)))
(test-equal "machine envelope" "(ok 3)\n"
  (vector-ref (run-client '("eval" "(+ 1 2)" "--machine") '("(ok 3)")) 1))
(let ((reply "(error oops () \"failure\" \"TRACE\" ((stage . execution)))"))
  (for-each
   (lambda (mode)
     (let ((result (run-client (append '("eval" "(error)") mode) (list reply))))
       (test-equal "operation error exit" 1 (vector-ref result 0))
       (if (member "--scheme" mode)
           (test-equal "complete error envelope" (string-append reply "\n") (vector-ref result 1))
           (begin (test-assert "error message" (has (vector-ref result 2) "failure"))
                  (test-equal "optional backtrace" (and (member "--backtrace" mode) #t) (has (vector-ref result 2) "TRACE"))))))
   '(("--scheme") () ("--backtrace"))))
(let ((result (run-client '("query" "desktop" "--json")
                          '("(ok ((schema-version . 1) (session . \"s\") (windows . #()) (groups . #()) (outputs . #()) (layouts . #(\"wide\")) (focused-window . null)))"))))
  (test-equal "empty array" #() (ref (json result) "windows"))
  (test-equal "null" 'null (ref (json result) "focused-window")))
(test-equal "raw Scheme tagged" '(("$scheme" . "((a . 1))"))
  (json (run-client '("eval" "'((a . 1))" "--json") '("(ok ((a . 1)))"))))
(define allocation "(ok ((session . \"s\") (revision . 7) (request-id . \"s:1\")))")
(define applied "(ok ((schema-version . 1) (session . \"s\") (revision . 8) (request-id . \"s:1\") (status . applied) (value . ((focused-window . 42)))))")
(let* ((result (run-client '("call" "focus-window!" "((window . 42))" "--json") (list allocation applied)))
       (call (cadr (sent result))))
  (test-equal "allocate once" "(new-action-request)" (car (sent result)))
  (for-each (lambda (part) (test-assert "guarded call" (has call part)))
            '("(quote ((window . 42)))" "#:session \"s\"" "#:if-revision 7" "#:request-id \"s:1\""))
  (test-equal "applied" "applied" (ref (json result) "status")))
(let ((result (run-client '("call" "focus-window!" "((window . 42))" "--session" "s" "--revision" "7" "--request-id" "s:1" "--scheme")
                          '("(ok ((status . error) (error . ((code . stale-state)))))"))))
  (test-equal "explicit receipt not allocated again" 1 (length (sent result)))
  (test-equal "stale result exit" 1 (vector-ref result 0)))
(let ((result (run-client '("wait" "s:1" "--session" "s" "--json")
                          '("(ok ((status . pending) (value . null)))" "(ok ((status . applied) (value . null)))"))))
  (test-equal "wait result" "applied" (ref (json result) "status"))
  (test-assert "wait does not re-execute" (every (lambda (r) (equal? r "(action-status \"s:1\" #:session \"s\")")) (sent result))))
(for-each
 (lambda (reply)
   (let ((result (run-client '("eval" "(set! x 1)" "--json") (list reply))))
     (test-equal "malformed reply exit" 3 (vector-ref result 0))
     (test-equal "malformed reply outcome" "unknown" (ref (ref (ref (json result) "error") "metadata") "outcome"))
     (test-equal "no retry" 1 (length (sent result)))))
 '("" "(ok" "(ok 1) (ok 2)" "#.(+ 1 2)" "(error bad () \"bad\" \"\" 42)"))
(for-each
 (lambda (arguments)
   (let ((result (run-client arguments '())))
     (test-equal "validation before connecting" '() (sent result))
     (test-equal "usage error exit" 2 (vector-ref result 0))
     (test-equal "not executed" #f (ref (ref (ref (json result) "error") "metadata") "execution-started?"))))
 '(("call" "focus-window!" "#.(error)" "--json") ("eval" "1" "--request-id" "s:1" "--json")))
(let ((result (run-client '("eval" "1" "--timeout-ms" "50" "--json") (list (cons "(ok 1)" 200000)))))
  (test-equal "read deadline" "timeout" (ref (ref (json result) "error") "code")))
(let ((result (run-client '("eval" "1" "--json") (list (make-string (+ 1 (* 1024 1024)) #\x)))))
  (test-equal "reply bound" "reply-too-large" (ref (ref (json result) "error") "code")))
(let ((result (run-client '("repl") '("(ok ((actions . ())))" "(ok 3)")
                          #:input "\n; comment\n#| block\n comment |#\n(+ 1\n 2)\n,quit\n")))
  (test-equal "multiline REPL" "3\n" (vector-ref result 1))
  (test-assert "complete expression" (has (cadr (sent result)) "(+ 1\n 2)")))
(let ((result (run-client '("repl") '("(ok ((actions . (((name . focus-window!))))))" "(ok 42)")
                          #:input "(focus-wi\t 42)\n,quit\n" #:interactive? #t)))
  (test-equal "interactive exit" 0 (vector-ref result 0))
  (test-assert "tab completion" (has (cadr (sent result)) "focus-window!")))
(let* ((result (run-client '("call" "focus-window!" "((window . 42))" "--json") (list allocation "")))
       (metadata (ref (ref (json result) "error") "metadata")))
  (test-equal "lost reply receipt" "s:1" (ref metadata "request-id"))
  (test-equal "lost reply session" "s" (ref metadata "session"))
  (test-equal "lost reply outcome" "unknown" (ref metadata "outcome"))
  (test-equal "lost reply no retry" 2 (length (sent result))))
(define initial "(ok ((session . \"s\") (event-sequence . 10) (windows . #())))")
(let ((result (run-client '("watch" "--json" "--count" "3")
                          (list initial "(ok ((session . \"s\") (sequence . 12) (gap . #f) (events . #())))"
                                "(ok ((session . \"s\") (sequence . 13) (gap . #f) (events . #(((sequence . 13) (name . focus-window) (arguments . #(42)))))))"))))
  (test-equal "watch starts after snapshot" "(events-since 10 #:session \"s\")" (cadr (sent result)))
  (test-equal "watch advances redacted watermark" "(events-since 12 #:session \"s\")" (caddr (sent result))))
(for-each
 (lambda (middle)
   (let ((result (run-client '("watch" "--json" "--count" "2")
                             (list initial middle "(ok ((session . \"new\") (event-sequence . 1) (windows . #())))"))))
     (test-equal "watch recovery exit" 0 (vector-ref result 0))
     (test-equal "watch resnapshots" "(desktop-snapshot)" (last (sent result)))))
 '("(ok ((session . \"s\") (sequence . 99) (gap . #t) (events . #())))"
   "(ok ((session . \"new\") (sequence . 1) (gap . #f) (events . #())))" ""))
(let ((runner (test-runner-current)))
  (test-end "control-cli")
  (exit (zero? (+ (test-runner-fail-count runner) (test-runner-xpass-count runner)))))
