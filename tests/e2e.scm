;;; Real key events, bounded observations and retained IPC envelopes.
(use-modules (ice-9 textual-ports) (srfi srfi-1) (srfi srfi-13)
             (minde control-client))
(define out (cadr (command-line)))
(define socket (string-append (getenv "XDG_RUNTIME_DIR") "/minde-ipc.sock"))
(define transcript (open-output-file (string-append out "/ipc.scm")))
(define (check condition . details) (unless condition (apply error details)))
(define (ms) (quotient (* 1000 (get-internal-real-time)) internal-time-units-per-second))
(define (remote expression)
  (let ((reply (ipc-request socket (format #f "~s" expression) #:timeout-ms 2000)))
    (write `(request ,expression reply ,reply) transcript)
    (newline transcript) (force-output transcript)
    (check (eq? (car reply) 'ok) "IPC failed; see ipc.scm" expression reply)
    (cadr reply)))
(define* (await label expression #:optional (expected #t))
  (let ((deadline (+ (ms) 6000)))
    (let loop ()
      (let ((actual (remote expression)))
        (unless (equal? actual expected)
          (check (< (ms) deadline) label "expected" expected "got" actual)
          (usleep 20000) (loop))))))
(define (run . arguments)
  (check (zero? (apply system* "timeout" "10" arguments)) "command failed" arguments))
(define (ok label) (format #t "ok - ~a~%" label) (force-output))
(define (shot name) (run "import" "-window" "root" (string-append out "/" name ".png")))
(define (press key name)
  (remote '(set! e2e-last-key #f))
  (run "xdotool" "key" "--clearmodifiers" key)
  ;; IPC and host input use different queues: seeing the callback finish is
  ;; the barrier for negative/unchanged assertions, never a fixed delay.
  (await (string-append "input not dispatched: " key) 'e2e-last-key name))
(define (prefix key name)
  (await "prefix started from a modal state" '(eq? %key-state 'normal))
  (press "Print" "Print")
  (await "prefix did not arm" '(eq? %key-state %prefix-bindings))
  (press key name))
(define (type-text text) (run "xdotool" "type" "--clearmodifiers" "--delay" "0" text))
(define (frames) (remote '(map frame-current-window (frame-leaves (current-tree)))))
(define (count-frames n) (await "frame count" '(length (frame-leaves (current-tree))) n))
(define (focus id)
  (remote `(focus-window-by-id! ,id))
  (await "focus setup" '(focused-window-id) id))
(define (message text) (await "message" '(last-message) text))
(define (fresh-message) (remote '(echo "e2e: before command")))
(define (log-text) (call-with-input-file (string-append out "/compositor.log") get-string-all))
(define (spawn name)
  (remote `(wm-spawn ,(format #f "foot --app-id=~a --title=~a sh -c 'sleep 180'" name name)))
  (await "client map" `(and (find (lambda (id) (equal? (window-app-id id) ,name))
                                 (all-window-ids)) #t))
  (remote `(find (lambda (id) (equal? (window-app-id id) ,name)) (all-window-ids))))

(remote '(begin
  (use-modules (minde compositor frames) (minde groups) (minde layouts) (minde control))
  (define e2e-handler wm-handle-key)
  (define e2e-last-key #f)
  (set! wm-handle-key
    (lambda (mods sym name text)
      (let ((result (e2e-handler mods sym name text)))
        (set! e2e-last-key name) result)))
  (define (e2e-buffer)
    (let ((state (@@ (minde ui prompt) %current)))
      (and state ((@@ (minde ui prompt) in-buffer) state))))
  (define (e2e-menu-selection)
    (let ((menu (@@ (minde ui menu) %menu)))
      (and menu
        (cdr (list-ref ((@@ (minde ui menu) menu-view) menu)
                      ((@@ (minde ui menu) menu-selected) menu))))))
  (define e2e-overlays '())
  (define e2e-add-overlay wm-add-overlay)
  (define e2e-clear-overlays wm-clear-overlays)
  (set! wm-add-overlay (lambda (x y text)
    (set! e2e-overlays (cons text e2e-overlays)) (e2e-add-overlay x y text)))
  (set! wm-clear-overlays (lambda () (set! e2e-overlays '()) (e2e-clear-overlays)))
  #t))

;; The startup reload cannot satisfy either observation. Damage a binding,
;; then require the real reload key to restore it and append a fresh log line.
(let ((before (string-length (log-text))))
  (remote '(begin (hash-remove! %prefix-bindings "y") #t))
  (prefix "shift+r" "R")
  (await "reload key did not restore configuration" '(and (hash-ref %prefix-bindings "y") #t))
  (check (string-contains (substring (log-text) before) "reloaded configuration")
         "reload key did not append a fresh success log"))
(ok "reload key restores configuration and appends a new success record")

(prefix "r" "r")
(await "run prompt" '(input-active?))
(type-text "foo") (await "typed prompt text" '(e2e-buffer) "foo")
(press "Tab" "Tab") (await "PATH completion" '(e2e-buffer) "foot")
(type-text " --app-id=e2e-one --title=e2e-one sh -c 'sleep 180'")
(await "complete run command" '(e2e-buffer) "foot --app-id=e2e-one --title=e2e-one sh -c 'sleep 180'")
(shot "prompt")
(press "Return" "Return")
(await "run prompt launched its client"
       '(and (find (lambda (id) (equal? (window-app-id id) "e2e-one")) (all-window-ids)) #t))
(define first (remote '(find (lambda (id) (equal? (window-app-id id) "e2e-one")) (all-window-ids))))
(define second (spawn "e2e-two"))
(focus first)
(prefix "y" "y")
(await "window info" '(and (string-contains (last-message) "e2e-one") #t))
(ok "run prompt types, completes and launches the selected program")

(count-frames 1)
(prefix "Print" "Print") (await "double-prefix window cycle" '(focused-window-id) second)
(await "double-prefix keeps the map armed" '(eq? %key-state %prefix-bindings))
(press "Escape" "Escape")
(prefix "v" "v") (count-frames 2)
(remote `(begin (focus-window-by-id! ,second) (move-window! 'down) (focus-frame-by-index! 0) #t))
(define initial-rect (remote '(current-frame-rect)))
(prefix "s" "s") (await "resize map" '(eq? %key-state %resize-map))
(press "Down" "Down")
(await "resize changed divider" `(not (equal? (current-frame-rect) ',initial-rect)))
(define resized-rect (remote '(current-frame-rect)))
(press "Down" "Down")
(await "second resize changed divider" `(not (equal? (current-frame-rect) ',resized-rect)))
(press "Return" "Return") (await "resize exit" '(eq? %key-state 'normal))
(prefix "Down" "Down") (await "directional frame focus" '(focused-window-id) second)
(prefix "Tab" "Tab") (await "previous window focus" '(focused-window-id) first)
(focus second)
(prefix "0" "0") (await "window number focus" '(focused-window-id) first)
(fresh-message) (prefix "shift+w" "W")
(message (remote '(echo-windows-string)))
(ok "split, double-prefix cycle, resize, direction, previous and numbered focus")

(fresh-message) (prefix "question" "question")
(await "which-key help" '(and (string-contains (last-message) "vsplit") #t))
(press "Escape" "Escape")
(prefix "F1" "F1") (await "describe-key armed" '(and %describe-next-key #t))
(press "v" "v") (message "v runs: vsplit") (count-frames 2)
(prefix "x" "x") (await "mark focused window" `(and (member ,first (marked-windows)) #t))
(prefix "x" "x") (await "unmark focused window" `(not (member ,first (marked-windows))))
(ok "help describes bindings and marks toggle the selected window")

(prefix "alt+f" "f") (await "fullscreen enabled" `(equal? (fullscreen-window (current-group)) ,first))
(prefix "alt+f" "f") (await "fullscreen disabled" '(not (fullscreen-window (current-group))))
(remote '(wm-warp-pointer 20 20)) (await "pointer setup" '(wm-pointer-position) '(20 20))
(prefix "shift+b" "B")
(await "banish moved pointer" '(let ((r (cdar (wm-outputs))))
  (equal? (wm-pointer-position) (list (- (+ (car r) (caddr r)) 2)
                                    (- (+ (cadr r) (cadddr r)) 2)))))
(define flash-token (remote '%next-timer-token))
(fresh-message) (prefix "ctrl+c" "c")
(await "frame flash message" '(and (string-prefix? "current frame:" (last-message)) #t))
(await "frame flash timer registered" `(> %next-timer-token ,flash-token))
(await "frame flash timer delivered" `(not (hash-ref %timers ,flash-token)))
(remote '(set-clipboard! "(+ 2 3)"))
(prefix "colon" "colon") (await "eval prompt" '(input-active?))
(press "ctrl+y" "y") (await "clipboard paste text" '(e2e-buffer) "(+ 2 3)")
(press "Return" "Return") (message "5")
(ok "fullscreen, pointer banish, flash timer and clipboard evaluation")

(for-each (lambda (key)
  (fresh-message) (prefix (car key) (cdr key)) (message "only one head")
  (await "single-head focus preserved" '(current-head-id) 0))
  '(("shift+s" . "S") ("alt+s" . "s")))
(await "nested output" '(map car (wm-outputs)) '(0))
(focus first)
(prefix "shift+f" "F") (await "float enabled" `(window-floating? ,first))
(define geometry (remote `(float-geometry ,first)))
(check (and (list? geometry) (= 4 (length geometry))) "missing float geometry" geometry)
(prefix "f" "f") (await "cycle off float" '(focused-window-id) second)
(await "float survives focus cycle" `(float-geometry ,first) geometry)
(focus first) (prefix "shift+f" "F") (await "float disabled" `(not (window-floating? ,first)))
(prefix "l" "l") (await "window menu opened" '(menu-active?))
(define menu-first (remote '(e2e-menu-selection)))
(press "ctrl+n" "n")
(define menu-second (remote '(e2e-menu-selection)))
(check (not (equal? menu-first menu-second)) "menu navigation did not select another window")
(press "Return" "Return") (await "menu focus" '(focused-window-id) menu-second)
(await "menu closed" '(not (menu-active?)))
(ok "head guard, float persistence and actual menu selection")

(remote '(rename-window! "e2e-renamed")) (await "rename" '(window-title (focused-window-id)) "e2e-renamed")
(remote '(toggle-always-on-top!))
(await "always on top enabled" '(and (member (focused-window-id) (ontop-windows)) #t))
(remote '(toggle-always-on-top!)) (await "always on top disabled" '(null? (ontop-windows)))
(define idle-before (remote '(idle-ms)))
(await "idle clock advances without input" `(>= (idle-ms) ,(+ idle-before 30)))
(prefix "z" "z") (await "command mode entered" '%command-mode)
(press "v" "v") (count-frames 3)
(press "c" "c") (count-frames 2)
(press "Return" "Return")
(await "command mode exited" '(and (not %command-mode) (eq? %key-state 'normal)))
(ok "rename, stacking flags, idle clock and bare command-mode keys")

(define parent (remote '(current-group-name)))
(remote '(begin (create-group-in-background! " e2eBG ") #t))
(await "background group exists" '(and (member " e2eBG " (group-names)) #t))
(await "background group did not steal focus" '(current-group-name) parent)
(focus first) (remote '(toggle-always-show!))
(remote '(switch-to-group! " e2eBG "))
(await "sticky follows group" `(and (equal? (focused-window-id) ,first)
  (group-has-window? " e2eBG " ,first)))
(remote '(begin (switch-to-last-group!) (toggle-always-show!) #t))
(await "return to original group" '(current-group-name) parent)
;; Give the pull menu a genuine cross-frame move to perform.
(remote `(begin (collapse-to-one-frame!) (split-frame-vertical!)
  (focus-window-by-id! ,second) (move-window! 'down) (focus-frame-by-index! 1) #t))
(check (not (remote `(and (member ,first (frame-window-ids (current-frame))) #t))) "pull precondition")
(prefix "alt+p" "p") (await "pull menu" '(menu-active?))
(await "pull menu target" '(e2e-menu-selection) first)
(press "Return" "Return")
(await "menu pulled window into current frame" `(and (member ,first (frame-window-ids (current-frame))) #t))
(prefix "j" "j") (await "fselect labels" '(length e2e-overlays) 2)
(press "0" "0")
(await "fselect focuses frame zero" '(eq? (current-frame) (car (frame-leaves (current-tree)))))
(await "fselect clears labels" 'e2e-overlays '())
(define original (remote '(dump-frames)))
(prefix "alt+e" "e") (await "expose labels" '(length e2e-overlays) 2)
(shot "expose")
(press "Escape" "Escape") (await "expose restores layout" '(dump-frames) original)
(await "expose clears labels" 'e2e-overlays '())
(ok "background groups, sticky movement, pull menu, frame selection and expose restoration")

(focus first)
(define rules-before (remote '(length (@@ (minde groups) %placement-rules))))
(remote '(remember!))
(await "remember adds a rule" '(length (@@ (minde groups) %placement-rules)) (+ rules-before 1))
(remote '(forget!))
(await "forget removes remembered rule" '(length (@@ (minde groups) %placement-rules)) rules-before)
;; A terminal in raw mode records the bytes delivered to the actual client.
;; A successful Scheme return alone says nothing about synthetic key delivery.
(define (check-client-keys app command)
  (let* ((path (string-append (getenv "XDG_RUNTIME_DIR") "/" app))
         (find-client `(find (lambda (id) (equal? (window-app-id id) ,app)) (all-window-ids)))
         (received `(and (file-exists? ,path)
                        (call-with-input-file ,path (@ (ice-9 textual-ports) get-string-all)))))
    (remote `(wm-spawn ,(format #f
      "~a sh -c 'stty -echo -icanon; touch \"$XDG_RUNTIME_DIR/~a-ready\"; dd bs=1 count=6 of=\"$XDG_RUNTIME_DIR/~a\" 2>/dev/null; sleep 180'"
      command app app)))
    (await "key recipient ready" `(and ,find-client (file-exists? ,(string-append path "-ready"))))
    (let ((client (remote find-client)))
      (focus client)
      (remote '(send-key "Down"))
      (await "synthetic Down reaches client" received "\x1b[B")
      (remote '(define-remapped-keys! (list (list ".*" (cons "C-F9" "Down")))))
      (await "remap lookup" '(remap-target "C-F9") "Down")
      (press "ctrl+F9" "F9")
      (await "remapped key reaches client" received "\x1b[B\x1b[B")
      (copy-file path (string-append out "/received-" app))
      (remote '(unbind-remapped-keys!)) (await "remap removed" '(remap-target "C-F9") #f)
      (remote `(wm-close-window ,client))
      (await "key recipient closed" `(not (member ,client (all-window-ids)))))))
(check-client-keys "e2e-keys" "foot --app-id=e2e-keys --title=e2e-keys")
(remote '(which-key-mode!)) (fresh-message)
(press "Print" "Print")
(await "delayed which-key help" '(and (string-contains (last-message) "vsplit") #t))
(press "Escape" "Escape") (remote '(which-key-mode!))
(for-each (lambda (key)
  (prefix key key) (await "help prompt opened" '(input-active?))
  (press "Escape" "Escape") (await "help prompt closed" '(not (input-active?)))) '("F2" "F5"))
(ok "placement persistence, synthetic and remapped key delivery, delayed help and prompt cancellation")

(remote '(begin (create-dynamic-group! " dyn ") #t))
(define third (spawn "e2e-three"))
(define fourth (spawn "e2e-four"))
(count-frames 2) (await "dynamic group selected" '(and (dynamic-group?) #t))
(define before-rotation (frames))
(prefix "alt+shift+g" "G") (press "r" "r")
(await "dynamic rotation" '(map frame-current-window (frame-leaves (current-tree))) (reverse before-rotation))
(define stack-window (cadr (frames)))
(focus stack-window)
(prefix "alt+shift+g" "G") (press "x" "x")
(await "exchange with master" '(frame-current-window (car (frame-leaves (current-tree)))) stack-window)
(define before-guard (remote '(dump-frames)))
(fresh-message) (prefix "v" "v")
(await "dynamic split guard preserves tree" '(dump-frames) before-guard)
(await "dynamic split rejection message" '(and (string-contains (last-message) "dynamic") #t))
(remote '(delete-current-group!)) (await "dynamic group removed" '(not (member " dyn " (group-names))))
(remote `(switch-to-group! ,parent))
(remote '(begin (apply-layout! "grid4") (set-gaps! 8 8) #t))
(count-frames 4)
(await "gap settings" '(let ((g (gap-settings))) (list (assq-ref g 'inner) (assq-ref g 'outer))) '(8 8))
(shot "layout")
(ok "dynamic rotation, master exchange, split refusal, group deletion and grid layout")

(when (and (search-path (parse-path (getenv "PATH")) "Xwayland")
           (search-path (parse-path (getenv "PATH")) "xterm")
           (not (equal? (getenv "MINDE_NO_XWAYLAND") "1")))
  (check-client-keys "E2EXterm" "xterm -class E2EXterm -e")
  (ok "Xwayland client maps with its actual class and receives the remapped key"))
(shot "reload")
(close-port transcript)
