;;; Exercise only the documented client interface in the private compositor.
(use-modules (ice-9 popen) (ice-9 textual-ports) (ice-9 binary-ports) (ice-9 rdelim)
             (rnrs bytevectors) (srfi srfi-1) (json) (minde agent))
(define out (cadr (command-line)))
(define measurements '())
(define selector-measurements '())
(define (ms) (* 1000.0 (/ (get-internal-real-time) internal-time-units-per-second)))
(define (check condition . detail) (unless condition (apply error detail)))
(define (invoke binary arguments success?)
  (let* ((port (apply open-pipe* OPEN_READ "timeout" "8" binary arguments))
         (text (get-string-all port)) (status (close-pipe port)))
    (check (eq? (zero? status) success?) binary arguments text status)
    (cons (load-json text) (bytevector-length (string->utf8 text)))))
(define* (cli arguments #:key (success? #t))
  (let* ((start (ms)) (result (invoke "scripts/mindectl" (append arguments '("--json")) success?)))
    (set! measurements (cons (object (cons "command" (car arguments)) (cons "ms" (- (ms) start))
                                     (cons "response_bytes" (cdr result))) measurements))
    (car result)))
(define (snapshot) (cli '("query" "desktop")))
(define (select request . arguments)
  (let* ((start (ms)) (result (invoke "scripts/minde-agent" (append (list "select" request) arguments) #t)))
    (set! selector-measurements (cons (object (cons "request" request) (cons "ms" (- (ms) start))) selector-measurements))
    (car result)))
(define (window state id) (find (lambda (w) (= (ref w "id") id)) (vector->list (ref state "windows"))))
(define* (call name arguments #:optional (request #f) #:key (success? #t))
  (cli (append (list "call" name arguments)
               (if request (list "--session" (ref request "session") "--revision" (number->string (ref request "revision"))
                                 "--request-id" (ref request "request-id")) '())) #:success? success?))
(define (target id) (format #f "((window . ~a))" id))
(define* (wait receipt #:key (success? #t))
  (cli (list "wait" (ref receipt "request-id") "--session" (ref receipt "session") "--timeout-ms" "4000")
       #:success? success?))
(define (status result expected) (check (equal? (ref result "status") expected) result expected))
(define (failure result expected) (check (equal? (ref (ref result "error") "code") expected) result expected))
(define (error-details result)
  ;; Compound error data deliberately retains its lossless Scheme JSON tag.
  (with-fluids ((read-eval? #f))
    (call-with-input-string (ref (ref (ref result "error") "details") "$scheme") read)))
;; Compare with the exact binary running this private session, including its
;; build stamp. Scheme must not infer a version from installed source files.
(let* ((port (open-pipe* OPEN_READ (caddr (command-line)) "--version"))
       (version (read-line port)))
  (check (zero? (close-pipe port)) "version command failed")
  (cli (list "eval" (format #f "(begin
    (unless (equal? (wm-version) ~s) (error \"native version disagrees with CLI\"))
    (version!)
    (unless (equal? (last-message) ~s) (error \"Scheme version disagrees with CLI\")) #t)"
                            version version))))
;; A personal command exists only in this session. Validation must use that
;; registry without invoking it or publishing a candidate keymap.
(cli '("eval" "(begin
  (define config-test-invoked? #f)
  (define config-test-bindings %prefix-bindings)
  (define config-test-prefix (list %prefix-mods %prefix-key))
  (define config-test-original (getenv \"MINDE_CONFIG\"))
  (register-command! 'personal-config-test!
    (lambda () (set! config-test-invoked? #t))
    #:category 'test #:summary \"Configuration validation test.\")
  #t)"))
(let ((file (string-append out "/personal-config.scm")))
  (define (save command)
    (call-with-output-file file
      (lambda (p)
        (write `(minde-config (version 1) (prefix () "Print")
                             (bindings ("F12" ,command))) p))))
  (save 'personal-config-test!)
  (failure (cli (list "check-config" file) #:success? #f) "invalid-configuration")
  (cli (list "check-config" file "--live"))
  (cli '("eval" "(begin
    (unless (and (not config-test-invoked?) (eq? config-test-bindings %prefix-bindings)
                 (equal? config-test-prefix (list %prefix-mods %prefix-key)))
      (error \"validation applied configuration or invoked a command\")) #t)"))
  (save 'focus-window!)
  (cli (list "check-config" file "--live") #:success? #f)
  (cli (list "eval" (format #f "(begin
    (setenv \"MINDE_CONFIG\" ~s)
    (when (reload-configuration!) (error \"reload accepted arguments\"))
    (unless (and (eq? config-test-bindings %prefix-bindings)
                 (equal? config-test-prefix (list %prefix-mods %prefix-key)))
      (error \"invalid reload changed keymap\")) #t)" file)))
  (save 'personal-config-test!)
  (cli '("eval" "(begin
    (unless (and (reload-configuration!) (string=? %prefix-key \"Print\")
                 (eq? (hash-ref %prefix-bindings \"F12\")
                      (command-procedure (command-ref 'personal-config-test!)))
                 (not config-test-invoked?))
      (error \"valid personal configuration did not reload\"))
    (if config-test-original (setenv \"MINDE_CONFIG\" config-test-original)
        (unsetenv \"MINDE_CONFIG\"))
    (unless (reload-configuration!) (error \"original configuration did not reload\")) #t)")))
;; Normalize both a prefix alias and reversed modifiers, then drive the
;; resulting binding through real XKB events in the private Xvfb session.
(let ((file (string-append out "/key-config.scm")))
  (define (save prefix keys)
    (call-with-output-file file
      (lambda (p)
        (write `(minde-config (version 1) (prefix () ,prefix)
                             (bindings ,@(map (lambda (key) (list key 'config-key-test!)) keys))) p))))
  (define (press expected)
    (check (zero? (system* "timeout" "5" "xdotool" "key" "--clearmodifiers" "Page_Up" "ctrl+alt+g"))
           "could not send private-session key events")
    (let loop ((remaining 20))
      (unless (= (cli '("eval" "config-key-hits")) expected)
        (check (positive? remaining) "normalized binding did not fire" expected)
        (usleep 100000) (loop (- remaining 1)))))
  (save "Page_Up" '("M-C-g"))
  (cli (list "eval" (format #f "(begin
    (define config-key-hits 0)
    (register-command! 'config-key-test! (lambda () (set! config-key-hits (+ config-key-hits 1)))
      #:category 'test #:summary \"Canonical key test.\")
    (setenv \"MINDE_CONFIG\" ~s)
    (unless (reload-configuration!) (error \"canonical key reload failed\"))
    (unless (and (string=? %prefix-key \"Prior\") (hash-ref %prefix-bindings \"C-M-g\")
                 (not (hash-ref %prefix-bindings \"M-C-g\")))
      (error \"configuration keys were not normalized\"))
    (define config-key-bindings %prefix-bindings) #t)" file)))
  (let* ((pipe (open-pipe* OPEN_READ "timeout" "5" "xdotool" "search" "--sync" "--name" "Smithay"))
         (window (read-line pipe)))
    (check (and (zero? (close-pipe pipe)) (string? window)) "private compositor window missing")
    (check (zero? (system* "timeout" "5" "xdotool" "windowfocus" window)) "could not focus private compositor"))
  (press 1)
  (for-each
   (lambda (candidate)
     (save (car candidate) (cdr candidate))
     (cli (list "check-config" file "--live") #:success? #f)
     (cli '("eval" "(begin
       (when (reload-configuration!) (error \"invalid key reload succeeded\"))
       (unless (and (eq? config-key-bindings %prefix-bindings) (string=? %prefix-key \"Prior\"))
         (error \"invalid key changed active configuration\")) #t)")))
   '(("Pritn" "g") ("Print" "Space") ("Print" "M-C-Prior" "C-M-Page_Up")))
  (press 2)
  (cli '("eval" "(begin
    (if config-test-original (setenv \"MINDE_CONFIG\" config-test-original) (unsetenv \"MINDE_CONFIG\"))
    (unless (reload-configuration!) (error \"original configuration did not reload\")) #t)")))
;; Observe the real keyboard callback's return value, preserving its normal
;; dispatch and forwarding behavior. Modifier events still traverse Rust.
(let ()
  (define (send . keys)
    (check (zero? (apply system* "timeout" "5" "xdotool" "key" "--clearmodifiers" keys))
           "could not send keymap regression keys"))
  (define (wait-for expression)
    (let loop ((remaining 12))
      (unless (cli (list "eval" expression))
        (check (positive? remaining) "keymap state did not settle" expression)
        (usleep 50000) (loop (- remaining 1)))))
  (cli '("eval" "(begin
    (define keymap-live-events '())
    (define keymap-live-ran 0)
    (define keymap-live-repeat-events '())
    (define keymap-live-handler wm-handle-key)
    (define keymap-live-repeat wm-set-key-repeat)
    (set! wm-handle-key (lambda (mods sym name text)
      (let ((consumed (keymap-live-handler mods sym name text)))
        (set! keymap-live-events (cons (cons name consumed) keymap-live-events)) consumed)))
    (bind-prefix-key! \"v\" (make-keymap \"t\" (lambda () (set! keymap-live-ran (+ keymap-live-ran 1)))))
    (bind-prefix-key! \"b\" (lambda () (set! keymap-live-ran (+ keymap-live-ran 1))))
    (set-prefix-key! '(ctrl) \"t\") #t)"))
  (send "ctrl+t" "v" "t" "a")
  (wait-for "(and (assoc \"a\" keymap-live-events) #t)")
  (cli '("eval" "(begin
    (unless (and (= keymap-live-ran 1) (eq? %key-state 'normal)
                 (not (assoc-ref keymap-live-events \"a\")))
      (error \"nested prefix keysym swallowed following input\" keymap-live-ran keymap-live-events))
    (set! keymap-live-events '()) #t)"))
  (send "ctrl+t" "m" "c" "t" "ctrl+t" "b" "a")
  (wait-for "(and (assoc \"a\" keymap-live-events) #t)")
  (cli '("eval" "(begin
    (unless (and (= keymap-live-ran 2) (not %command-mode) (eq? %key-state 'normal)
                 (not (assoc-ref keymap-live-events \"a\")))
      (error \"literal escape left command mode active\"))
    (set! wm-handle-key keymap-live-handler)
    (set! wm-set-key-repeat (lambda (enabled?)
      (set! keymap-live-repeat-events (cons enabled? keymap-live-repeat-events))
      (keymap-live-repeat enabled?))) #t)"))
  (for-each
   (lambda (open)
     (cli (list "eval" (string-append "(begin
       (set! keymap-live-repeat-events '())
       (define keymap-live-flash-token %next-timer-token)
       (define keymap-live-generation %keymap-generation)
       (flash-current-frame!) " open " #t)")))
     (wait-for "(not (hash-ref %timers keymap-live-flash-token))")
     (cli '("eval" "(begin
       (unless (and (or (input-active?) (menu-active?))
                    (equal? keymap-live-repeat-events '(#t))
                    (= keymap-live-generation %keymap-generation))
         (error \"frame flash changed keyboard ownership or invalidated help\"))
       (wm-handle-key 0 0 \"Escape\" \"\") #t)")))
   '("(read-one-line \"flash prompt: \" (lambda (_) #t))"
     "(select-from-menu '(\"one\" \"two\") (lambda (_) #t))"))
  (cli '("eval" "(begin (set! wm-set-key-repeat keymap-live-repeat)
    (unless (reload-configuration!) (error \"could not restore keymap configuration\")) #t)"))
  (cli '("eval" "(begin
    (define selection-live-original (dump-frames))
    (define selection-live-group (current-group))
    (define selection-live-add wm-add-overlay)
    (define selection-live-clear wm-clear-overlays)
    (define selection-live-labels '())
    (define selection-live-key #f)
    (set! wm-add-overlay (lambda (x y label)
      (set! selection-live-labels (cons label selection-live-labels))
      (selection-live-add x y label)))
    (set! wm-clear-overlays (lambda ()
      (set! selection-live-labels '()) (selection-live-clear)))
    (set! wm-handle-key (lambda (mods sym name text)
      (let ((result (keymap-live-handler mods sym name text)))
        (set! selection-live-key name) result)))
    (split-frame-horizontal!)
    (define selection-live-split (dump-frames))
    (set-prefix-key! '(ctrl) \"t\")
    (bind-prefix-key! \"e\" expose-mode!)
    (bind-prefix-key! \"j\" fselect!) #t)"))
  (for-each
   (lambda (entry)
     (cli '("eval" "(begin (set! selection-live-key #f) #t)"))
     (send "ctrl+t" entry "z")
     (wait-for "(equal? selection-live-key \"z\")")
     (cli '("eval" "(begin
       (unless (and (eq? %key-state 'normal) (null? selection-live-labels)
                    (equal? selection-live-split (dump-frames)))
         (error \"unbound key left a modal layout or overlays active\")) #t)")))
   '("e" "j"))
  (cli '("eval" "(begin
    (set-key-state! %prefix-bindings)
    (wm-handle-key 0 0 \"f\" \"\")
    (define selection-live-timer (- %next-timer-token 1))
    (set-key-state! (expose-mode!)) #t)"))
  (wait-for "(not (hash-ref %timers selection-live-timer))")
  (cli '("eval" "(begin
    (unless (and (hash-table? %key-state) (pair? selection-live-labels))
      (error \"old native timer erased expose labels\"))
    (switch-to-next-group!)
    (unless (and (eq? %key-state 'normal) (null? selection-live-labels))
      (error \"group switch left modal selection active\"))
    (switch-to-group! selection-live-group)
    (unless (equal? selection-live-split (dump-frames))
      (error \"group switch lost the expose snapshot\"))
    (restore-frames! selection-live-original)
    (set! wm-add-overlay selection-live-add)
    (set! wm-clear-overlays selection-live-clear)
    (set! wm-handle-key keymap-live-handler)
    (unless (reload-configuration!) (error \"could not restore modal test configuration\")) #t)")))
(let ((names (map (lambda (a) (ref a "name")) (vector->list (ref (cli '("capabilities")) "actions")))))
  (for-each (lambda (operation)
              (check (member operation names) operation)
              (check (ref (cli (list "help" operation)) "parameters") operation))
            '("windows" "focus-window!" "move-window-to-group!" "set-window-floating!" "set-window-fullscreen!"
              "split-frame!" "apply-layout!" "close-window!" "screenshot")))
(define state (snapshot))
(check (= (vector-length (ref state "windows")) 2) state)
(define (window-id app)
  (ref (find (lambda (w) (equal? (ref w "app-id") app)) (vector->list (ref state "windows"))) "id"))
(define first (window-id "control-one"))
(define second (window-id "control-two"))
(check (not (ref (window state first) "visible")) "initial hidden window")
(check (equal? (ref (window state first) "title") (ref (window state second) "title")) "duplicate titles")
(status (call "focus-window!" (target first)) "applied")
(set! state (snapshot))
(check (and (= (ref state "focused-window") first) (equal? (ref state "focused-group") " I ")) state)
(let ((dry-run (select "focus control-two")))
  (status dry-run "dry-run")
  (check (= (ref (ref dry-run "arguments") "window") second) dry-run))
(check (equal? (ref (select "focus Same title") "reason") "ambiguous") "ambiguous title")
(check (= (ref (snapshot) "focused-window") first) "dry-run mutated focus")
(let ((selected (select "focus control-two" "--execute" "--allow" "focus-window!")))
  (status selected "submitted") (status (ref selected "result") "applied"))
(check (= (ref (snapshot) "focused-window") second) "selected target")
(call "focus-window!" (target first))
(define request (cli '("request")))
(define floating-args (format #f "((window . ~a) (enabled . #t))" first))
(define aliased-id
  (let* ((prefix (string-append (ref request "session") ":"))
         (id (ref request "request-id")))
    (string-append prefix "0" (substring id (string-length prefix)))))
(let ((alias-request (object (cons "session" (ref request "session"))
                             (cons "revision" (ref request "revision"))
                             (cons "request-id" aliased-id))))
  (failure (call "set-window-floating!" floating-args alias-request #:success? #f) "invalid-request-id")
  (check (not (ref (window (snapshot) first) "floating")) "aliased request changed floating state"))
(define floating (call "set-window-floating!" floating-args request))
(status floating "applied")
(check (equal? (ref floating "request-id") (ref request "request-id")) "receipt echoed an altered ID")
(failure (cli (list "wait" aliased-id "--session" (ref request "session") "--timeout-ms" "100")
              #:success? #f) "invalid-request-id")
(check (ref (window (snapshot) first) "floating") "floating")
(check (json-equal? floating (call "set-window-floating!" floating-args request)) "idempotent receipt")
(status (call "set-window-floating!" floating-args) "unchanged")
(failure (call "set-window-floating!" (format #f "((window . ~a) (enabled . #f))" first) request #:success? #f)
         "request-id-conflict")
(check (ref (window (snapshot) first) "floating") "conflict changed floating state")
(set! request (cli '("request")))
(call "switch-group!" "((group . \" II \"))")
(let* ((reply (call "close-window!" (target first) request #:success? #f))
       (details (error-details reply)))
  (failure reply "stale-state")
  (check (and (equal? (assq-ref details 'expected) (ref request "revision"))
              (integer? (assq-ref details 'actual))
              (> (assq-ref details 'actual) (assq-ref details 'expected)))
         "stale-state JSON details are not a flat alist" reply))
(check (= (vector-length (ref (snapshot) "windows")) 2) "stale request closed window")
(call "focus-window!" (target first))
(define (screenshot path id) (format #f "((path . ~s) (window . ~a))" path id))
(define path (string-append out "/window.png"))
(define capture (call "screenshot" (screenshot path first)))
(status capture "pending")
(status (wait capture) "applied")
(let* ((png (call-with-input-file path (lambda (p) (get-bytevector-n p 24)) #:binary #t))
       (geometry (ref (window (snapshot) first) "geometry")))
  (check (equal? (take (bytevector->u8-list png) 8) '(137 80 78 71 13 10 26 10)) "PNG signature")
  (check (= (bytevector-u32-ref png 16 (endianness big)) (vector-ref geometry 2)) "PNG width")
  (check (= (bytevector-u32-ref png 20 (endianness big)) (vector-ref geometry 3)) "PNG height"))
(let ((capture (call "screenshot" (screenshot (string-append out "/missing-parent/capture.png") first))))
  (status capture "pending") (failure (wait capture #:success? #f) "operation-failed"))
(define before (snapshot))
(call "move-window-to-group!" (format #f "((window . ~a) (group . \" II \"))" first))
(define after (snapshot))
(check (and (equal? (ref (window after first) "group") " II ") (equal? (ref after "focused-group") " I ")) after)
(check (> (ref after "revision") (ref before "revision")) "revision advanced")
(let ((events (cli (list "events-since" (number->string (ref before "event-sequence")) "--session" (ref before "session")))))
  (check (and (not (ref events "gap")) (>= (ref events "sequence") (ref before "event-sequence"))) events))
(failure (call "screenshot" (screenshot (string-append out "/offscreen.png") first) #:success? #f) "target-unavailable")
(let ((reply (call "close-window!" "((window . \"wrong type\"))" #:success? #f)))
  (failure reply "invalid-argument")
  (check (eq? (assq-ref (error-details reply) 'parameter) 'window)
         "argument-validation JSON details changed shape" reply))
(check (= (vector-length (ref (snapshot) "windows")) 2) "invalid request closed window")
;; Exercise frame membership with the same real clients before closing one.
(for-each (lambda (id)
            (call "move-window-to-group!" (format #f "((window . ~a) (group . \" I \"))" id)))
          (list first second))
(cli (list "eval" (format #f
  "(begin
     (unfloat-window! ~a) (collapse-to-one-frame!)
     (pull-window-by-id! ~a) (pull-window-by-id! ~a)
     (unless (= (length (all-window-ids)) 2) (error \"duplicate pull membership\"))
     (float-window! ~a) (collapse-to-one-frame!)
     (apply-layout-spec! '(hsplit 1/2 leaf leaf))
     (unless (equal? (append-map frame-window-ids (frame-leaves (current-tree))) '(~a))
       (error \"layout included a float\"))
     (unfloat-window! ~a) (collapse-to-one-frame!)
     (clear-current-frame!) (split-frame-horizontal!) (focus-next-frame!)
     (pull-window-from-other-frame!) (pull-window-from-other-frame!)
     (unless (and (= (length (all-window-ids)) 2) (every exact-integer? (all-window-ids)))
       (error \"cleared source corrupted frame membership\"))
     #t)" first first first second first second)))
;; Reject new name collisions, then simulate legacy duplicate names through
;; private state to verify that focusing a real client uses owner identity.
(cli '("eval" "(begin
  (define identity-a (create-group-in-background! \"identity-a\"))
  (define identity-b (create-group-in-background! \"identity-b\"))
  (let ((before (group-names)))
    (unless (catch #t (lambda () (create-group! \" identity-a \") #f) (lambda args #t))
      (error \"duplicate group name accepted\"))
    (unless (equal? before (group-names)) (error \"rejected creation changed groups\")))
  #t)"))
(call "move-window-to-group!" (format #f "((window . ~a) (group . \"identity-b\"))" first))
(cli '("eval" "(begin
  ((@@ (minde compositor model) set-group-name!) identity-b \"identity-a\")
  (switch-to-group! \"identity-a\") #t)"))
(status (call "focus-window!" (target first)) "applied")
(check (= (ref (snapshot) "focused-window") first) "duplicate-name owner focus")
(cli '("eval" "(begin
  (unless (eq? identity-b (current-group)) (error \"focused wrong duplicate-name group\"))
  (delete-current-group!)
  (unless (string=? (current-group-name) \" I \") (error \"last-group deletion did not wrap\"))
  #t)"))
(check (ref (window (snapshot) first) "visible") "deleted group's client stayed hidden")
(cli '("eval" "(begin (create-dynamic-group! \"frame-regression\") #t)"))
(for-each (lambda (id)
            (call "move-window-to-group!" (format #f "((window . ~a) (group . \"frame-regression\"))" id)))
          (list first second))
(cli (list "eval" (format #f
  "(begin
     (focus-window-by-id! ~a) (switch-to-group! \" I \")
     (switch-to-group! \"frame-regression\")
     (unless (equal? (focused-window-id) ~a)
       (error \"returning to dynamic group lost stack focus\"))
     #t)" first first)))
(cli (list "eval" (format #f
  "(begin
     (float-window! ~a) (retile-dynamic!) (focus-window-by-id! ~a)
     (let ((before (dump-frames)))
       (exchange-with-master!)
       (unless (equal? before (dump-frames)) (error \"float entered dynamic order\")))
     #t)" second second)))
(check (= (ref (snapshot) "focused-window") second) "exchange lost actual float focus")
(status (wait (call "close-window!" (target second))) "applied")
(check (equal? (map (lambda (w) (ref w "id")) (vector->list (ref (snapshot) "windows"))) (list first)) "close target")
(cli (list "eval" (format #f "(unless (equal? (all-window-ids) '(~a)) (error \"closed float left a frame member\"))" first)))
(let ((reply (call "focus-window!" (target second) #:success? #f)))
  (failure reply "unknown-window")
  (check (equal? (assq-ref (error-details reply) 'window) second)
         "control-error JSON details are not a flat alist" reply))
(let* ((times (sort (map (lambda (r) (ref r "ms")) measurements) <)) (n (length times))
       (p50 (/ (+ (list-ref times (quotient n 2)) (list-ref times (quotient (- n 1) 2))) 2))
       (p95 (list-ref times (min (- n 1) (floor (* n 95/100)))))
       (report (object (cons "scenario" "isolated-native-wayland") (cons "passed" #t) (cons "cli_calls" n)
                       (cons "p50_ms" p50) (cons "p95_ms" p95)
                       (cons "max_response_bytes" (apply max (map (lambda (r) (ref r "response_bytes")) measurements)))
                       (cons "deterministic_selector_calls" (list->vector (reverse selector-measurements)))
                       (cons "measurements" (list->vector (reverse measurements))))))
  (call-with-output-file (string-append out "/results.json") (lambda (p) (scm->json report p) (newline p)))
  (format #t "control-e2e: all checks passed; ~a CLI calls, p50=~,1fms p95=~,1fms~%" n p50 p95))
