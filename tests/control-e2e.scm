;;; Exercise only the documented client interface in the private compositor.
(use-modules (ice-9 popen) (ice-9 textual-ports) (ice-9 binary-ports)
             (rnrs bytevectors) (srfi srfi-1) (json) (minde agent))
(define out (cadr (command-line)))
(define measurements '())
(define selector-measurements '())
(define (ms) (* 1000.0 (/ (get-internal-real-time) internal-time-units-per-second)))
(define (check condition . detail) (unless condition (apply error detail)))
(define (invoke binary arguments success?)
  (let* ((port (apply open-pipe* OPEN_READ "timeout" "8" binary arguments))
         (text (get-string-all port)) (status (close-pipe port)))
    (check (eq? (zero? status) success?) binary arguments text status)
    (cons (load-json text) (bytevector-length (string->utf8 text)))))
(define* (cli arguments #:key (success? #t))
  (let* ((start (ms)) (result (invoke "scripts/mindectl" (append arguments '("--json")) success?)))
    (set! measurements (cons (object (cons "command" (car arguments)) (cons "ms" (- (ms) start))
                                     (cons "response_bytes" (cdr result))) measurements))
    (car result)))
(define (snapshot) (cli '("query" "desktop")))
(define (select request . arguments)
  (let* ((start (ms)) (result (invoke "scripts/minde-agent" (append (list "select" request) arguments) #t)))
    (set! selector-measurements (cons (object (cons "request" request) (cons "ms" (- (ms) start))) selector-measurements))
    (car result)))
(define (window state id) (find (lambda (w) (= (ref w "id") id)) (vector->list (ref state "windows"))))
(define* (call name arguments #:optional (request #f) #:key (success? #t))
  (cli (append (list "call" name arguments)
               (if request (list "--session" (ref request "session") "--revision" (number->string (ref request "revision"))
                                 "--request-id" (ref request "request-id")) '())) #:success? success?))
(define (target id) (format #f "((window . ~a))" id))
(define* (wait receipt #:key (success? #t))
  (cli (list "wait" (ref receipt "request-id") "--session" (ref receipt "session") "--timeout-ms" "4000")
       #:success? success?))
(define (status result expected) (check (equal? (ref result "status") expected) result expected))
(define (failure result expected) (check (equal? (ref (ref result "error") "code") expected) result expected))
(let ((names (map (lambda (a) (ref a "name")) (vector->list (ref (cli '("capabilities")) "actions")))))
  (for-each (lambda (operation)
              (check (member operation names) operation)
              (check (ref (cli (list "help" operation)) "parameters") operation))
            '("windows" "focus-window!" "move-window-to-group!" "set-window-floating!" "set-window-fullscreen!"
              "split-frame!" "apply-layout!" "close-window!" "screenshot")))
(define state (snapshot))
(check (= (vector-length (ref state "windows")) 2) state)
(define (window-id app)
  (ref (find (lambda (w) (equal? (ref w "app-id") app)) (vector->list (ref state "windows"))) "id"))
(define first (window-id "control-one"))
(define second (window-id "control-two"))
(check (not (ref (window state first) "visible")) "initial hidden window")
(check (equal? (ref (window state first) "title") (ref (window state second) "title")) "duplicate titles")
(status (call "focus-window!" (target first)) "applied")
(set! state (snapshot))
(check (and (= (ref state "focused-window") first) (equal? (ref state "focused-group") " I ")) state)
(let ((dry-run (select "focus control-two")))
  (status dry-run "dry-run")
  (check (= (ref (ref dry-run "arguments") "window") second) dry-run))
(check (equal? (ref (select "focus Same title") "reason") "ambiguous") "ambiguous title")
(check (= (ref (snapshot) "focused-window") first) "dry-run mutated focus")
(let ((selected (select "focus control-two" "--execute" "--allow" "focus-window!")))
  (status selected "submitted") (status (ref selected "result") "applied"))
(check (= (ref (snapshot) "focused-window") second) "selected target")
(call "focus-window!" (target first))
(define request (cli '("request")))
(define floating-args (format #f "((window . ~a) (enabled . #t))" first))
(define floating (call "set-window-floating!" floating-args request))
(status floating "applied")
(check (ref (window (snapshot) first) "floating") "floating")
(check (json-equal? floating (call "set-window-floating!" floating-args request)) "idempotent receipt")
(status (call "set-window-floating!" floating-args) "unchanged")
(failure (call "set-window-floating!" (format #f "((window . ~a) (enabled . #f))" first) request #:success? #f)
         "request-id-conflict")
(check (ref (window (snapshot) first) "floating") "conflict changed floating state")
(set! request (cli '("request")))
(call "switch-group!" "((group . \" II \"))")
(failure (call "close-window!" (target first) request #:success? #f) "stale-state")
(check (= (vector-length (ref (snapshot) "windows")) 2) "stale request closed window")
(call "focus-window!" (target first))
(define (screenshot path id) (format #f "((path . ~s) (window . ~a))" path id))
(define path (string-append out "/window.png"))
(define capture (call "screenshot" (screenshot path first)))
(status capture "pending")
(status (wait capture) "applied")
(let* ((png (call-with-input-file path (lambda (p) (get-bytevector-n p 24)) #:binary #t))
       (geometry (ref (window (snapshot) first) "geometry")))
  (check (equal? (take (bytevector->u8-list png) 8) '(137 80 78 71 13 10 26 10)) "PNG signature")
  (check (= (bytevector-u32-ref png 16 (endianness big)) (vector-ref geometry 2)) "PNG width")
  (check (= (bytevector-u32-ref png 20 (endianness big)) (vector-ref geometry 3)) "PNG height"))
(let ((capture (call "screenshot" (screenshot (string-append out "/missing-parent/capture.png") first))))
  (status capture "pending") (failure (wait capture #:success? #f) "operation-failed"))
(define before (snapshot))
(call "move-window-to-group!" (format #f "((window . ~a) (group . \" II \"))" first))
(define after (snapshot))
(check (and (equal? (ref (window after first) "group") " II ") (equal? (ref after "focused-group") " I ")) after)
(check (> (ref after "revision") (ref before "revision")) "revision advanced")
(let ((events (cli (list "events-since" (number->string (ref before "event-sequence")) "--session" (ref before "session")))))
  (check (and (not (ref events "gap")) (>= (ref events "sequence") (ref before "event-sequence"))) events))
(failure (call "screenshot" (screenshot (string-append out "/offscreen.png") first) #:success? #f) "target-unavailable")
(failure (call "close-window!" "((window . \"wrong type\"))" #:success? #f) "invalid-argument")
(check (= (vector-length (ref (snapshot) "windows")) 2) "invalid request closed window")
;; Exercise frame membership with the same real clients before closing one.
(for-each (lambda (id)
            (call "move-window-to-group!" (format #f "((window . ~a) (group . \" I \"))" id)))
          (list first second))
(cli (list "eval" (format #f
  "(begin
     (unfloat-window! ~a) (collapse-to-one-frame!)
     (pull-window-by-id! ~a) (pull-window-by-id! ~a)
     (unless (= (length (all-window-ids)) 2) (error \"duplicate pull membership\"))
     (float-window! ~a) (collapse-to-one-frame!)
     (apply-layout-spec! '(hsplit 1/2 leaf leaf))
     (unless (equal? (append-map frame-window-ids (frame-leaves (current-tree))) '(~a))
       (error \"layout included a float\"))
     (unfloat-window! ~a) (collapse-to-one-frame!)
     (clear-current-frame!) (split-frame-horizontal!) (focus-next-frame!)
     (pull-window-from-other-frame!) (pull-window-from-other-frame!)
     (unless (and (= (length (all-window-ids)) 2) (every exact-integer? (all-window-ids)))
       (error \"cleared source corrupted frame membership\"))
     #t)" first first first second first second)))
(cli '("eval" "(begin (create-dynamic-group! \"frame-regression\") #t)"))
(for-each (lambda (id)
            (call "move-window-to-group!" (format #f "((window . ~a) (group . \"frame-regression\"))" id)))
          (list first second))
(cli (list "eval" (format #f
  "(begin
     (float-window! ~a) (retile-dynamic!) (focus-window-by-id! ~a)
     (let ((before (dump-frames)))
       (exchange-with-master!)
       (unless (equal? before (dump-frames)) (error \"float entered dynamic order\")))
     #t)" second second)))
(check (= (ref (snapshot) "focused-window") second) "exchange lost actual float focus")
(status (wait (call "close-window!" (target second))) "applied")
(check (equal? (map (lambda (w) (ref w "id")) (vector->list (ref (snapshot) "windows"))) (list first)) "close target")
(cli (list "eval" (format #f "(unless (equal? (all-window-ids) '(~a)) (error \"closed float left a frame member\"))" first)))
(failure (call "focus-window!" (target second) #:success? #f) "unknown-window")
(let* ((times (sort (map (lambda (r) (ref r "ms")) measurements) <)) (n (length times))
       (p50 (/ (+ (list-ref times (quotient n 2)) (list-ref times (quotient (- n 1) 2))) 2))
       (p95 (list-ref times (min (- n 1) (floor (* n 95/100)))))
       (report (object (cons "scenario" "isolated-native-wayland") (cons "passed" #t) (cons "cli_calls" n)
                       (cons "p50_ms" p50) (cons "p95_ms" p95)
                       (cons "max_response_bytes" (apply max (map (lambda (r) (ref r "response_bytes")) measurements)))
                       (cons "deterministic_selector_calls" (list->vector (reverse selector-measurements)))
                       (cons "measurements" (list->vector (reverse measurements))))))
  (call-with-output-file (string-append out "/results.json") (lambda (p) (scm->json report p) (newline p)))
  (format #t "control-e2e: all checks passed; ~a CLI calls, p50=~,1fms p95=~,1fms~%" n p50 p95))
