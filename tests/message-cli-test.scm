;;; Check the expression handed to IPC without connecting to a compositor.
(use-modules (ice-9 textual-ports) (srfi srfi-64))
(test-begin "message-cli")
(let* ((directory (mkdtemp (string-copy "/tmp/minde-message-XXXXXX")))
       (script (string-append directory "/minde-msg"))
       (stub (string-append directory "/minde-cmd"))
       (expression (string-append directory "/expression"))
       (output (string-append directory "/stdout"))
       (errors (string-append directory "/stderr")))
  (define (contents path) (call-with-input-file path get-string-all))
  (define (run args)
    (when (file-exists? expression) (delete-file expression))
    (status:exit-val
      (apply system* "sh" "-c" "exec \"$@\" >\"$MINDE_MESSAGE_TEST_OUT\" 2>\"$MINDE_MESSAGE_TEST_ERR\""
             "sh" script args)))
  (define (valid args expected)
    (test-equal "valid arguments reach IPC" 0 (run args))
    (test-assert "IPC receives an expression" (file-exists? expression))
    (when (file-exists? expression)
      (with-fluids ((read-eval? #f))
        (call-with-input-file expression
          (lambda (port)
            (test-equal "message and timeout are literal data" expected (read port))
            (test-assert "exactly one expression" (eof-object? (read port))))))))
  (define (invalid args)
    (test-equal "invalid arguments exit with usage status" 2 (run args))
    (test-assert "invalid arguments never reach IPC" (not (file-exists? expression)))
    (test-equal "usage errors leave stdout empty" "" (contents output))
    (test-assert "usage error explains invocation" (string-contains (contents errors) "usage:")))
  (dynamic-wind
    (lambda () #t)
    (lambda ()
      (copy-file "scripts/minde-msg" script)
      (chmod script #o700)
      (call-with-output-file stub
        (lambda (port)
          (display "#!/bin/sh\nprintf '%s\\n' \"$1\" >\"$MINDE_MESSAGE_TEST_EXPR\"\nexit \"${MINDE_MESSAGE_TEST_STATUS:-0}\"\n" port)))
      (chmod stub #o700)
      (setenv "MINDE_MESSAGE_TEST_EXPR" expression)
      (setenv "MINDE_MESSAGE_TEST_OUT" output)
      (setenv "MINDE_MESSAGE_TEST_ERR" errors)
      (setenv "MINDE_MESSAGE_TEST_STATUS" "0")
      (for-each invalid
        '(() ("-t") ("-t" "1") ("--") ("-t" "1" "--")
          ("-t" "" "message") ("-t" "abc" "message")
          ("-t" "1.5" "message") ("-t" "-1" "message")
          ("-t" "1e3" "message") ("-t" "#x10" "message")
          ("-t" "1) (wm-message \"injected\"" "message")
          ("-t" "9223372036854775808" "message")
          ("--unknown" "message")))
      (valid '("hello" "world") '(wm-message "hello world"))
      (valid '("") '(wm-message ""))
      (valid '("-t" "1500" "hello") '(wm-message "hello" 1500))
      (valid '("-t" "0" "hello") '(wm-message "hello" 0))
      (valid '("-t" "0008" "hello") '(wm-message "hello" 8))
      (valid '("-t" "9223372036854775807" "hello") '(wm-message "hello" 9223372036854775807))
      (valid '("--" "-t" "5" "hello") '(wm-message "-t 5 hello"))
      (valid '("-t" "5" "--" "-t" "literal") '(wm-message "-t literal" 5))
      (let ((text "λ: \"quoted\" \\ path\n\") (error \"injected\")\n\n"))
        (valid (list "--" text) (list 'wm-message text)))
      (setenv "MINDE_MESSAGE_TEST_STATUS" "7")
      (test-equal "IPC exit status is preserved" 7 (run '("message"))))
    (lambda () (system* "rm" "-rf" "--" directory))))
(let ((runner (test-runner-current)))
  (test-end "message-cli")
  (exit (zero? (+ (test-runner-fail-count runner) (test-runner-xpass-count runner)))))
