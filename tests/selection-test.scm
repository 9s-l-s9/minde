;;; Modal picks must restore their owning desktop context on every exit.
(use-modules (srfi srfi-1))
(define %overlays '())
(define %placements (make-hash-table))
(define %repeat '())
(define (wm-spawn command) #t)
(define (wm-quit) #t)
(define (wm-log message) #t)
(define (wm-place-window id . rectangle) (hash-set! %placements id rectangle) #t)
(define (wm-focus-window id) #t)
(define (wm-close-window id) #t)
(define (wm-clear-focus) #t)
(define (wm-focus-rect . args) #t)
(define (wm-output-geometry) '(0 0 1280 720))
(define (wm-message . args) #t)
(define (wm-clear-message) #t)
(define (wm-border-color . args) #t)
(define (wm-run-after-ms . args) #t)
(define (wm-set-key-repeat enabled?) (set! %repeat (cons enabled? %repeat)))
(define (wm-add-overlay x y label) (set! %overlays (cons label %overlays)) #t)
(define (wm-clear-overlays) (set! %overlays '()) #t)
(define (wm-session-locked?) #f)
(define (wm-session-lock-confirmed?) #f)
(setenv "MINDE_CONFIG" "scheme/default-config.scm")
(setenv "MINDE_RULES_FILE" "/nonexistent-minde-selection-rules")
(fluid-set! %file-port-name-canonicalization 'absolute)
(primitive-load (canonicalize-path "scheme/init.scm"))
(define failures 0)
(define (check name got expected)
  (unless (equal? got expected)
    (set! failures (+ failures 1))
    (format #t "FAIL - ~a: expected ~s, got ~s~%" name expected got)))
(define (key name) (wm-handle-key 0 #f name ""))
(define (enter-expose) (set-key-state! (expose-mode!)))
(define (enter-fselect) (set-key-state! (fselect!)))
(handle-window-map! 1 "one" "foot")
(handle-window-map! 2 "two" "foot")
(handle-window-map! 3 "three" "foot")
(split-frame-horizontal!)
(move-window! 'right)
(define original (dump-frames))

(for-each
 (lambda (exit)
   (enter-expose)
   (check "expose owns a keymap" (hash-table? %key-state) #t)
   (exit)
   (check "exit restores the complete original layout" (dump-frames) original)
   (check "exit clears overlays" %overlays '())
   (check "exit leaves normal key state" %key-state 'normal))
 (list (lambda () (key "unbound")) (lambda () (key "Escape"))
       (lambda () (key "Return")) (lambda () (wm-handle-key 4 #f "g" ""))
       (lambda () (set-key-state! 'normal))
       (lambda () (wm-on-session-lock))
       (lambda ()
         (hash-set! %key-state "bad" (lambda () (error "bad selection action")))
         (key "bad"))))
(expose-enter!)
(expose-enter!)
(expose-pick! #f)
(check "repeated low-level expose preserves the original snapshot" (dump-frames) original)
(enter-expose)
(enter-expose)
(key "unbound")
(check "repeated modal entry preserves the original snapshot" (dump-frames) original)

(enter-fselect)
(key "Shift_L")
(check "modifier press keeps labels" (length %overlays) 2)
(key "question")
(check "help keeps selection armed" (hash-table? %key-state) #t)
(key "unbound")
(check "unbound fselect clears labels" %overlays '())
(enter-fselect)
(wm-on-session-lock)
(check "locking cancels fselect" (list %key-state %overlays) '(normal ()))

;; The portable frame-map timer must not erase a later selection's labels.
(set-key-state! %prefix-bindings)
(key "f")
(define old-timer (- %next-timer-token 1))
(enter-fselect)
(handle-timer! old-timer)
(check "old frame timer preserves fselect overlays" (length %overlays) 2)
(key "Escape")
(set-key-state! %prefix-bindings)
(key "f")
(set! old-timer (- %next-timer-token 1))
(enter-expose)
(handle-timer! old-timer)
(check "old frame timer preserves expose overlays" (length %overlays) 3)
(key "Escape")

;; Cancel before parking so restoration cannot put outgoing windows back on
;; screen, and never apply one group's snapshot to its destination.
(define group-a (current-group))
(define group-b (create-group-in-background! "selection other"))
(enter-expose)
(switch-to-group! group-b)
(define group-b-dump (dump-frames))
(expose-pick! #f)
(check "late pick cannot overwrite another group" (dump-frames) group-b-dump)
(check "group switch cancels the map" %key-state 'normal)
(check "outgoing windows stay parked"
       (every (lambda (id) (< (car (hash-ref %placements id)) 0)) '(1 2 3)) #t)
(switch-to-group! group-a)
(check "group switch restores the originating layout" (dump-frames) original)

(handle-heads-change! '((10 0 0 1280 720) (11 1280 0 1280 720)))
(define head-a-dump (dump-frames))
(enter-expose)
(focus-head! 11)
(define head-b-dump (dump-frames))
(expose-pick! #f)
(check "late pick cannot overwrite another head" (dump-frames) head-b-dump)
(focus-head! 10)
(check "head switch restores the originating layout" (dump-frames) head-a-dump)
(enter-fselect)
(focus-head! 11)
(check "head switch clears fselect" (list %key-state %overlays) '(normal ()))
(focus-head! 10)
(enter-expose)
(handle-heads-change! '((10 0 0 1000 700)))
(check "hotplug cancels selection before resizing" (dump-frames) head-a-dump)
(check "hotplug clears the modal map" %key-state 'normal)

;; A group/head change with no keymap must leave prompt-owned repeat alone.
(read-one-line "test" (lambda (_) #t))
(set! %repeat '())
(switch-to-group! group-b)
(check "context switch leaves prompt key repeat alone" %repeat '())
(key "Escape")
(switch-to-group! group-a)

;; More than ten windows use letters; more than 36 use equal-width labels.
(for-each (lambda (id) (handle-window-map! id (number->string id) "foot")) (iota 34 4))
(define many-original (dump-frames))
(enter-expose)
(check "every exposed window gets a pick label" (length %overlays) 37)
(check "labels have fixed width past 36" (every (lambda (s) (= 2 (string-length s))) %overlays) #t)
(define picked (frame-current-window (list-ref (frame-leaves (current-tree)) 36)))
(key "1")
(check "first pick key keeps the modal map" (hash-table? %key-state) #t)
(check "first pick key keeps overlays" (length %overlays) 37)
(key "0")
(check "two-key pick focuses the last window" (focused-window-id) picked)
(check "two-key pick restores the split layout" (dump-layout-spec) (car many-original))
(check "two-key pick clears overlays" %overlays '())
(restore-frames! many-original)
(enter-expose)
(key "0")
(key "unbound")
(check "unbound key in pick submap restores layout" (dump-frames) many-original)
(for-each handle-window-unmap! (iota 25 13))
(enter-expose)
(check "eleventh cell is labeled a" (and (member "a" %overlays) #t) #t)
(set! picked (frame-current-window (list-ref (frame-leaves (current-tree)) 10)))
(key "a")
(check "letter pick focuses the eleventh window" (focused-window-id) picked)

(define before-many-frames (dump-frames))
(apply-layout-spec! (chain-spec 'horizontal 37))
(focus-frame-by-index! 36)
(define last-frame-rect (current-frame-rect))
(focus-frame-by-index! 0)
(enter-fselect)
(check "large fselect has labels for every frame" (length %overlays) 37)
(key "1")
(key "0")
(check "two-key fselect reaches frame 36" (current-frame-rect) last-frame-rect)
(check "two-key fselect clears overlays" %overlays '())
(restore-frames! before-many-frames)

;; The cancel action is shared by a modal map and its child, runs once on
;; departure, and does not prevent future dispatch if it throws.
(let* ((cancelled 0) (cancel (lambda () (set! cancelled (+ 1 cancelled))))
       (child (make-keymap)) (parent (make-keymap "x" child)))
  (set-keymap-cancel! child cancel)
  (set-keymap-cancel! parent cancel)
  (set-key-state! parent)
  (key "x")
  (check "entering a modal child does not cancel" cancelled 0)
  (key "unbound")
  (check "leaving the modal child cancels once" cancelled 1)
  (set-key-state! 'normal)
  (check "already departed mode is not cancelled twice" cancelled 1)
  (set-keymap-cancel! parent (lambda () (error "bad cancellation")))
  (set-key-state! parent)
  (key "unbound")
  (check "bad cancellation leaves input usable" %key-state 'normal))

;; A focus hook can leave the group during expose's sync itself.
(define before-hook (dump-frames))
(define (switch-during-expose . args)
  (remove-event-hook! 'focus-frame switch-during-expose)
  (switch-to-group! group-b))
(add-event-hook! 'focus-frame switch-during-expose)
(check "reentrant group change aborts expose entry" (expose-enter!) #f)
(check "reentrant change retains destination group" (eq? (current-group) group-b) #t)
(switch-to-group! group-a)
(check "reentrant change preserves the original layout" (dump-frames) before-hook)

(if (zero? failures) (display "all modal selection tests passed\n") (exit 1))
