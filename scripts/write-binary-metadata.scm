;;; Emit data, never executable Scheme, for binary-closure consumers.
(use-modules (ice-9 match) (ice-9 popen) (ice-9 rdelim))
(match (cdr (command-line))
  ((out revision version minde xwayland)
   (define (path name) (string-append out "/" name))
   (define (digest name)
     (let* ((port (open-pipe* OPEN_READ "sha256sum" "--" (path name)))
            (line (read-line port)) (status (close-pipe port)))
       (unless (and (zero? status) (string? line) (>= (string-length line) 64))
         (error "could not hash artifact" name))
       (substring line 0 64)))
   (when (>= (stat:size (stat (path "minde-x86_64-linux.nar.xz"))) (* 2 (expt 1024 3)))
     (error "binary archive exceeds the GitHub Release asset limit"))
   (call-with-output-file (path "binary.scm")
     (lambda (port)
       (write `((schema . 1) (repository . "9s-l-s9/minde") (commit . ,revision)
                (version . ,version) (system . "x86_64-linux") (minde . ,minde)
                (xwayland . ,xwayland) (archive-sha256 . ,(digest "minde-x86_64-linux.nar.xz"))
                (key-sha256 . ,(digest "signing-key.pub")) (closure-sha256 . ,(digest "closure.txt"))) port)
       (newline port))))
  (_ (error "expected output directory, revision, version, Minde and Xwayland store paths")))
