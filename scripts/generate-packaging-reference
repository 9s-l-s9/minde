#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Generate the packaging/distribution reference by extracting facts straight
# from the sources of truth -- manifest.scm, guix.scm, release/contract.env,
# and doc/releasing.md -- so it cannot drift from the real build/install
# recipe or the real release contract.
set -eu

cd "$(dirname "$0")/.."

out=${1:-doc/generated/packaging.md}
mkdir -p "$(dirname "$out")"

release_version=$(sed -n 's/^MINDE_RELEASE_VERSION=//p' release/contract.env)

# manifest.scm: one double-quoted package spec per line inside the list.
manifest_packages=$(sed -n 's/^[[:space:]]*"\([^"]*\)".*/\1/p' manifest.scm)

# guix.scm: pull the three input lists out by their (list ...) blocks. Each
# block is `(native-inputs / inputs / propagated-inputs \n (list a b c))`;
# awk collects identifiers between the matching parens.
extract_inputs() {
    # $1: guix.scm field name, e.g. native-inputs. The field's `(list ...)`
    # body is the whole clause, so collecting from the field line to the
    # first following line ending in `))` captures exactly that input list.
    awk -v start="  ($1" '
        $0 == start { collecting = 1 }
        collecting { print; if (collecting > 1 && $0 ~ /\)\)[[:space:]]*$/) exit; collecting++ }
    ' guix.scm |
        tr -d '()\n' |
        tr -s ' ' '\n' |
        sed 's/^"cargo"$/rust:cargo/' |
        grep -vE '^[[:space:]]*$' |
        grep -vE '^(native-inputs|inputs|propagated-inputs|list|rust)$' |
        sort -u
}

guix_native_inputs=$(extract_inputs native-inputs)
guix_inputs=$(extract_inputs inputs)
guix_propagated_inputs=$(extract_inputs propagated-inputs)

# Installed file layout: pull the destination-directory bindings and the
# install-file/copy-recursively targets out of the (replace 'install ...)
# phase in guix.scm, in source order, deduplicated.
# The install phase names its destinations with `(name (string-append out
# "/path"))` let* bindings; pull those literal "/path" suffixes in source
# order. It is the final phase in guix.scm, so everything from its `(replace
# 'install` line to end of file belongs to it.
install_phase_start=$(grep -n "(replace 'install" guix.scm | cut -d: -f1)
installed_layout=$(tail -n "+$install_phase_start" guix.scm |
    grep -oE '\(string-append out "/[a-zA-Z0-9./_-]*"\)' |
    sed -E 's#.*"(/[a-zA-Z0-9./_-]*)".*#\1#' |
    sed 's#^/##' |
    awk '!seen[$0]++')

session_desktop_exec=$(sed -n 's/^Exec=//p' guix.scm)

{
    echo "<!-- Generated by scripts/generate-packaging-reference; do not edit by hand. -->"
    echo "<!-- Regenerate with: make docs -->"
    echo "# Packaging and distribution reference"
    echo
    echo "This reference is extracted programmatically from \`manifest.scm\`,"
    echo "\`guix.scm\`, \`release/contract.env\`, and \`doc/releasing.md\` so it"
    echo "cannot drift from the real build recipe or release contract. For"
    echo "narrative packaging guidance see"
    echo "[\`../releasing.md\`](../releasing.md); for the roadmap decision"
    echo "record see"
    echo "[\`../release-roadmap.md\`](../release-roadmap.md#release-decisions)."
    echo
    echo "Release-candidate version: \`$release_version\` (from"
    echo "\`release/contract.env\`)."
    echo

    echo "## Build dependencies (development shell, \`manifest.scm\`)"
    echo
    echo "Entered with \`guix shell -m manifest.scm\`:"
    echo
    for pkg in $manifest_packages; do
        echo "- \`$pkg\`"
    done
    echo

    echo "## Guix package inputs (\`guix.scm\`)"
    echo
    echo "### Native inputs (build-time only)"
    echo
    for pkg in $guix_native_inputs; do
        echo "- \`$pkg\`"
    done
    echo
    echo "### Inputs (linked/runtime)"
    echo
    for pkg in $guix_inputs; do
        echo "- \`$pkg\`"
    done
    echo
    echo "### Propagated inputs (installed alongside minde in the same profile)"
    echo
    for pkg in $guix_propagated_inputs; do
        echo "- \`$pkg\`"
    done
    echo "  (smithay execs \`Xwayland\` from \`PATH\` at runtime; propagation puts"
    echo "  it in the same profile as minde, which matters for a system"
    echo "  profile such as SDDM's.)"
    echo

    echo "## Installed file layout (from the \`install\` phase of \`guix.scm\`)"
    echo
    echo "| Path (relative to the package output) | Contents |"
    echo "|---|---|"
    for path in $installed_layout; do
        case "$path" in
        bin) purpose="minde binary, minde-session wrapper, REPL-socket helpers (minde-cmd, minde-msg, mindectl)" ;;
        share/minde) purpose="runtime Scheme tree and default-config.scm" ;;
        share/guile/site/3.0) purpose="installed minde Guile modules (GUILE_LOAD_PATH root)" ;;
        share/doc/minde) purpose="README, changelog, policies, provenance, licenses, doc/, release/" ;;
        share/wayland-sessions) purpose="minde.desktop Wayland session entry" ;;
        lib/guile/3.0/site-ccache) purpose="compiled .go bytecode for scheme/, built at package time so a login loads compiled modules instead of autocompiling (GUILE_LOAD_COMPILED_PATH, set by minde-session)" ;;
        *) purpose="-" ;;
        esac
        echo "| \`$path\` | $purpose |"
    done
    echo

    echo "## Wayland session entry"
    echo
    if [ -n "$session_desktop_exec" ]; then
        echo "\`share/wayland-sessions/minde.desktop\` runs \`Exec=$session_desktop_exec\`,"
    else
        echo "\`share/wayland-sessions/minde.desktop\` runs the session wrapper,"
    fi
    echo "which is installed at \`bin/minde-session\`. The wrapper sets"
    echo "\`XDG_CURRENT_DESKTOP\`, \`MINDE_SCHEME_DIR\`, \`GUILE_LOAD_PATH\`, and"
    echo "\`__EGL_VENDOR_LIBRARY_DIRS\`, falls back to the packaged"
    echo "\`init.scm\` when \`~/.config/minde/init.scm\` is absent, and execs"
    echo "\`bin/minde --tty\`, redirecting output to"
    echo "\`\$XDG_STATE_HOME/minde/session.log\` (previous-generation log kept"
    echo "as \`session.previous.log\`)."
    echo

    echo "## Obtaining and verifying release archives"
    echo
    echo "Two deterministic archives are produced per tagged release (see"
    echo "[\`../releasing.md\`](../releasing.md#reproducible-archives)):"
    echo
    echo "- \`minde-\$VERSION.tar.gz\` -- source only, excludes \`vendor/\`."
    echo "- \`minde-\$VERSION-vendored.tar.gz\` -- source plus the vendored"
    echo "  Cargo dependency graph, suitable for fully offline Cargo and Guix"
    echo "  builds and required by \`guix/release.scm\`."
    echo
    echo "Both are built with \`make release-archives VERSION=\$VERSION\` and"
    echo "verified reproducible with \`make check-release-archives\`; archive"
    echo "order, ownership, timestamps, tar format, and gzip metadata are"
    echo "normalized so two independent builds are byte-identical. A published"
    echo "release additionally provides a \`SHA256SUMS\` file (produced by"
    echo "\`make release\`) alongside the archives; verify a downloaded archive"
    echo "with \`sha256sum -c SHA256SUMS\` before extracting it."
    echo

    echo "## Installing via the in-repo Guix channel"
    echo
    echo "This repository is a Guix channel (\`.guix-channel\` ->"
    echo "\`guix-channel/\`, see"
    echo "[\`../../guix-channel/minde/packages.scm\`](../../guix-channel/minde/packages.scm))."
    echo "Add it to \`~/.config/guix/channels.scm\` and run \`guix pull\`, or"
    echo "build directly against a checkout without pulling:"
    echo
    echo '```sh'
    echo "guix build -L guix-channel guile-minde-foundation"
    echo "guix build -L guix-channel guile-minde-ui"
    echo '```'
    echo
    echo "**What the channel provides today:** only the two reusable, pure-Scheme"
    echo "libraries, \`guile-minde-foundation\` and \`guile-minde-ui\`."
    echo "**What it does not yet provide:** the \`minde\` compositor itself. The"
    echo "compositor's Guix recipe (\`guix.scm\`) builds from a vendored Cargo"
    echo "dependency tree under \`vendor/\`, which is deliberately gitignored and"
    echo "therefore invisible to a channel checkout (\`guix pull\` only sees"
    echo "committed files). The channel will gain a \`minde\` package once a"
    echo "tagged release publishes the vendored archive"
    echo "(\`minde-\$VERSION-vendored.tar.gz\`) at a stable URL with a known"
    echo "hash, at which point the channel package can \`url-fetch\` it exactly"
    echo "as \`guix/release.scm\` does from \`MINDE_SOURCE_ARCHIVE\`. Until"
    echo "then, installing the compositor requires a checkout and \`guix.scm\`"
    echo "(or \`guix/release.scm\` against a locally vendored archive), as"
    echo "described above."
    echo

    echo "## Screen capture and desktop-portal support"
    echo
    echo "Extracted from \`doc/capability-matrix.md\` (the capability-status"
    echo "source of truth):"
    echo
    echo '```'
    grep 'Screencopy/screenshot protocol' doc/capability-matrix.md
    echo '```'
    echo
    if grep -q '^   "grim"$' manifest.scm; then
        echo "\`grim\` is part of the development shell (\`manifest.scm\`) and is"
        echo "the reference client: Guix packages \`grim\` 1.5.0, which speaks"
        echo "\`ext-image-copy-capture-v1\` and works against minde today."
    else
        echo "\`grim\` >= 1.5.0 (the first release speaking"
        echo "\`ext-image-copy-capture-v1\`) is the reference screenshot client."
    fi
    echo
    echo "**Portal-based screen sharing is now expected to work, pending"
    echo "owner hardware verification.** minde serves the legacy"
    echo "\`wlr-screencopy-unstable-v1\` (v3) protocol alongside"
    echo "\`ext-image-copy-capture-v1\`, so the screen-cast portal backend"
    echo "packaged in Guix, \`xdg-desktop-portal-wlr\` (0.8.2) -- which speaks"
    echo "\`wlr-screencopy\` only -- can now capture minde's outputs, which"
    echo "is the path browser screen sharing uses. \`wf-recorder\`, another"
    echo "pure \`wlr-screencopy\` client, is exercised by the nested e2e gate."
    echo "The portal path itself has been wired but not yet verified on real"
    echo "hardware/PipeWire; a portal backend speaking"
    echo "\`ext-image-copy-capture-v1\` directly (such as"
    echo "\`xdg-desktop-portal-luminous\`) remains an alternative but is not"
    echo "currently packaged in Guix. See"
    echo "[\`../release-roadmap.md\`](../release-roadmap.md#screen-capture-and-desktop-portal)"
    echo "for the tracked follow-up."
    echo

    echo "## Support boundary"
    echo
    echo "First-party support target: pinned Guix, installed either from a"
    echo "checkout (\`guix.scm\`) or, for the two reusable libraries, from this"
    echo "repository's Guix channel. Other distributions are community-packaged"
    echo "from the vendored release archive"
    echo "(\`minde-\$VERSION-vendored.tar.gz\`), offline and reproducible by"
    echo "construction, but their packaging and testing are not first-party (see"
    echo "[\`../release-roadmap.md\`](../release-roadmap.md#release-decisions) and"
    echo "[\`../support.md\`](../support.md))."
} >"$out"
