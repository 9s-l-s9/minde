#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
GUILE=${MINDE_GUILE:-guile}
script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$script_dir/../scheme/minde/agent.scm" ]; then
    modules=$script_dir/../scheme
else
    modules=$script_dir/../share/minde/scheme
fi
export MINDE_AGENT_CTL="$script_dir/mindectl"
exec "$GUILE" -q --no-auto-compile -L "$modules" -c \
    '(use-modules (minde agent)) (exit (agent-main (cdr (command-line))))' "$@"
