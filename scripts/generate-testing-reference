#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Generate the complete verification-command reference from `./check --help`
# and the Makefile's phony targets, so the index cannot drift from the real
# entry points. Preceding `#` comment lines on a target are used as its
# one-line purpose; targets without one are left blank rather than guessed.
set -eu

cd "$(dirname "$0")/.."

out=${1:-doc/testing.md}

{
    echo "<!-- Generated by scripts/generate-testing-reference; do not edit by hand. -->"
    echo "<!-- Regenerate with: make docs -->"
    echo "# Complete verification command reference"
    echo
    echo "This index is generated from \`./check --help\` and the \`Makefile\`'s"
    echo "phony targets so it cannot drift from the real commands. For narrative"
    echo "guidance see [\`../README.md\`](../README.md#development)"
    echo "and [\`debugging.md\`](debugging.md)."
    echo
    echo "\`./check\` with no arguments and \`make check\` are not the same"
    echo "gate: the bare \`./check\` fast path runs \`cargo check\` (a type"
    echo "check, no build or tests) alongside the Scheme/API/configuration/"
    echo "keymap suites and static analysis, while \`make check\` runs"
    echo "\`check-rust\` (\`cargo fmt --check\`, a full \`cargo build\`,"
    echo "\`cargo test\`, and \`cargo clippy\`) ahead of the same Scheme/API/"
    echo "configuration/keymap suites. \`make check\` is strictly stronger and"
    echo "slower; \`./check\` is the fast inner-loop gate for Scheme-only"
    echo "changes. This divergence is intentional but easy to forget, so use"
    echo "\`make check\` (or \`make check-rust\` alone) before trusting a Rust"
    echo "change that only \`./check\` has seen."
    echo
    echo "## \`./check\`"
    echo
    echo '```'
    ./check --help
    echo '```'
    echo
    echo "## \`make\` targets"
    echo
    echo "Every target below is declared \`.PHONY\` in \`Makefile\`. Run"
    echo "\`make TARGET\` from the repository root inside"
    echo "\`guix shell -m manifest.scm\`."
    echo
    echo "| Target | Purpose |"
    echo "|---|---|"
    awk '
        /^#/ {
            comment = $0
            sub(/^# */, "", comment)
            pending = pending (pending == "" ? "" : " ") comment
            next
        }
        /^[A-Za-z0-9_-]+:/ {
            name = $0
            sub(/:.*/, "", name)
            purpose = pending
            gsub(/\|/, "\\|", purpose)
            print "| `make " name "` | " (purpose == "" ? "-" : purpose) " |"
            pending = ""
            next
        }
        { pending = "" }
    ' Makefile
} >"$out"
