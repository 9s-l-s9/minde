#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

root=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
. "$root/release/contract.env"
host=$(hostname 2>/dev/null || printf unknown)
safe_host=$(printf '%s' "$host" | tr -c 'A-Za-z0-9._-' '_')
stamp=$(date -u +%Y%m%dT%H%M%SZ)
output=${1:-build/hardware/$safe_host-$stamp.md}
mkdir -p "$(dirname "$output")"

command_output() {
    title=$1
    shift
    printf '\n### %s\n\n```text\n' "$title"
    "$@" 2>&1 || printf 'unavailable or command failed\n'
    printf '```\n'
}

{
    printf '# minde hardware report: %s\n' "$host"
    # Markdown backticks are intentional literal characters.
    # shellcheck disable=SC2016
    printf '\nGenerated: `%s`\n' "$stamp"
    # shellcheck disable=SC2016
    printf '\nRelease candidate: `%s`\n' "$MINDE_RELEASE_VERSION"
    printf '\n## Static snapshot\n'
    command_output Kernel uname -a
    command_output 'Guix system generation' readlink -f /var/guix/profiles/system
    if command -v lspci >/dev/null 2>&1; then
        command_output 'PCI graphics and drivers' sh -c \
            "lspci -nnk | sed -n '/VGA compatible controller/,+4p;/Display controller/,+4p'"
    else
        command_output 'PCI graphics and drivers' false
    fi
    command_output 'DRM devices' sh -c 'ls -l /dev/dri 2>/dev/null'
    # The single-quoted program is expanded by the child shell, not this one.
    # shellcheck disable=SC2016
    command_output 'DRM connectors' sh -c '
        found=false
        for status in /sys/class/drm/card*-*/status; do
            [ -r "$status" ] || continue
            found=true
            printf "%s: %s\n" "${status%/status}" "$(cat "$status")"
        done
        "$found"'
    if command -v loginctl >/dev/null 2>&1; then
        command_output 'Seat' loginctl seat-status "${XDG_SEAT:-seat0}"
    else
        command_output 'Seat' false
    fi

    cat <<'EOF'

## Owner checklist

Generation collects information only; it does not run these checks. Follow
doc/hardware-validation.md from a spare VT in a disposable test session.
Record pass/fail and evidence for each applicable item. Mark unavailable
hardware and optional features N/A with a reason in the results; an unchecked
item is pending, not a pass.

### Release-default session

- [ ] Direct DRM/TTY startup and clean exit with the bundled configuration
- [ ] Keyboard and pointer, selected XKB layout, and default C-t prefix
- [ ] Native Wayland terminal and GTK/Qt application
- [ ] Xwayland mapping and clipboard in both directions, when enabled
- [ ] Frame split, resize, movement, exchange, float, and fullscreen
- [ ] VT switch away and back, with input and repaint restored
- [ ] Login and logout using the RC package in the configured display manager
- [ ] Known-good rollback session remains selectable
- [ ] Forced compositor crash in the test session leaves useful redacted diagnostics
- [ ] Four-hour soak completed without crash or unbounded RSS
- [ ] Prior Guix generation rollback tested

### Session lock and suspend

- [ ] Configured ext-session-lock-v1 locker covers every output; authenticate and unlock
- [ ] Keyboard, pointer and touch reach only the locker while locked
- [ ] suspend! waits for a confirmed locked frame on every active output
- [ ] Resume stays locked until authentication; repeat lid close/open where present
- [ ] Killing the test session's locker keeps outputs locked or black and starts a replacement
- [ ] Replacement locker authenticates and unlocks; manual recovery from another VT is available

### Hardware and external clients

- [ ] Output hotplug, scaling and arrangement, including kanshi/wlr-randr changes
- [ ] Clipboard manager preserves clipboard and primary-selection transfers
- [ ] wf-recorder recording contains changing frames and stops cleanly
- [ ] Browser portal screen sharing through xdg-desktop-portal-wlr and PipeWire
- [ ] Idle manager blanks outputs with DPMS; activity restores them without losing layout
- [ ] Touch/stylus mapping, gestures and pressure on available hardware, including lock isolation

### Personal configuration (optional; record separately from the defaults)

- [ ] Configured keyboard layout, prefix and custom bindings
- [ ] Brightness/audio keys and other configured hardware policy
- [ ] External panel, wallpaper and autostart programs, if configured

## Results and notes

Outcome: pending owner

Tested package/revision, configuration paths, keyboard layout and locker:

Display manager, external clients and versions:

Unavailable hardware or optional features (N/A with reason):

Failures/workarounds:

Retained logs or report paths:
EOF
} >"$output"

printf '%s\n' "$output"
