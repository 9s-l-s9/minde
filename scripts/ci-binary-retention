#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Plan (by default) or apply retention for this workflow's binary downloads.
set -eu
mode=${1:---plan}
if [ "$#" -gt 1 ] || { [ "$mode" != --plan ] && [ "$mode" != --apply ]; }; then
    echo 'usage: scripts/ci-binary-retention [--plan | --apply]' >&2
    exit 2
fi
repo=9s-l-s9/minde
current=${GITHUB_SHA:-}
fail() { echo "binary retention: $*" >&2; exit 1; }
if [ "$mode" = --apply ]; then
    if ! { [ "${GITHUB_ACTIONS:-}" = true ] &&
    [ "${GITHUB_REPOSITORY:-}" = "$repo" ] &&
    [ "${GITHUB_REF:-}" = refs/heads/main ] &&
    [ "${GITHUB_WORKFLOW_REF:-}" = "$repo/.github/workflows/guix-binary.yml@refs/heads/main" ]; }; then
        fail 'apply requires the canonical main binary workflow'
    fi
    jq -en --arg sha "$current" '$sha | test("^[0-9a-f]{40}$")' >/dev/null ||
        fail 'the current workflow commit is missing or invalid'
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/minde-binary-retention.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
api() {
    gh api --hostname github.com -H 'Accept: application/vnd.github+json' \
        -H 'X-GitHub-Api-Version: 2022-11-28' "$@"
}

snapshot() {
    # Fetch every page before planning any deletion. No run-search filters:
    # GitHub caps filtered searches at 1,000 results, hiding older reservations.
    api --paginate "repos/$repo/releases?per_page=100" >"$work/releases.pages"
    api --paginate "repos/$repo/git/matching-refs/tags/guix-" >"$work/refs.pages"
    api --paginate "repos/$repo/actions/workflows/guix-binary.yml/runs?per_page=100" >"$work/runs.pages"
    jq -es 'if length > 0 and all(.[]; type == "array") then add
            else error("invalid release pages") end' "$work/releases.pages" >"$work/releases.json"
    jq -es 'if length > 0 and all(.[]; type == "array") then add
            else error("invalid reference pages") end' "$work/refs.pages" >"$work/refs.json"
    jq -es 'if length > 0 and all(.[]; (.workflow_runs | type) == "array")
            then [.[] | .workflow_runs[]] else error("invalid workflow pages") end' \
        "$work/runs.pages" >"$work/runs.json"
    # Missing status/identity data must not turn a live run into an orphan.
    jq -e 'all(.[]; (.head_sha | type) == "string" and (.head_sha | test("^[0-9a-f]{40}$"))
         and (.status | type) == "string" and (.status | length) > 0)' \
        "$work/runs.json" >/dev/null || fail 'incomplete workflow run data'
    jq -e 'all(.[]; (.tag_name | type) == "string" and (.id | type) == "number" and .id > 0 and .id == (.id | floor)
         and (.draft | type) == "boolean" and (.prerelease | type) == "boolean")' \
        "$work/releases.json" >/dev/null || fail 'incomplete release data'
    jq -e 'all(.[]; (.ref | type) == "string" and (.object.sha | type) == "string"
         and (.object.type | type) == "string")' "$work/refs.json" >/dev/null ||
        fail 'incomplete reference data'
    # Pagination can overlap when the remote collection changes between pages.
    # Never count one release twice when deciding which five builds to retain.
    jq -e 'length == (unique_by(.id) | length)
         and length == (unique_by(.tag_name) | length)' "$work/releases.json" >/dev/null ||
        fail 'duplicate release data; retry with a fresh snapshot'
    jq -e 'length == (unique_by(.ref) | length)' "$work/refs.json" >/dev/null ||
        fail 'duplicate reference data; retry with a fresh snapshot'
}

plan() {
    jq -n --arg repo "$repo" --arg current "$current" \
        --slurpfile releases "$work/releases.json" --slurpfile refs "$work/refs.json" \
        --slurpfile runs "$work/runs.json" '
      [$refs[0][] | select(.ref | test("^refs/tags/guix-[0-9a-f]{40}$"))
       | select(.object.type == "commit" and .object.sha == (.ref | ltrimstr("refs/tags/guix-")))
       | {key: (.ref | ltrimstr("refs/tags/")), value: .object.sha}] | from_entries as $tags
      | ([$current] + [$runs[0][] | select(.status != "completed") | .head_sha]) as $protected
      | [$runs[0][] | select(.status == "completed" and .head_branch == "main"
                and .head_repository.full_name == $repo) | .head_sha] as $finished
      | [$releases[0][] | select(.prerelease and (.draft | not) and (.immutable != true)
                and .author.login == "github-actions[bot]" and $tags[.tag_name] != null)
         | if (.published_at | type) != "string" then error("missing publication date")
           elif (.published_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$") | not)
           then error("invalid publication date") else . end
        ] | sort_by(.published_at, .id) | reverse as $published
      | ([$published[5:][] | . as $release | select(($protected | index($tags[$release.tag_name])) == null)
          | {kind: "release", tag: .tag_name, sha: $tags[.tag_name], id: .id}]
         + [$tags | to_entries[] | . as $tag
            | select(($protected | index($tag.value)) == null
                 and ($finished | index($tag.value)) != null
                 and ([$releases[0][].tag_name] | index($tag.key)) == null)
            | {kind: "tag", tag: .key, sha: .value}])'
}

snapshot
plan >"$work/plan.json"
cat "$work/plan.json"
[ "$mode" = --apply ] || exit 0
jq -c '.[]' "$work/plan.json" >"$work/candidates"
while IFS= read -r candidate; do
    # Recheck publication, tag targets and all active statuses immediately
    # before each deletion. A rerun or newly published orphan is protected.
    snapshot
    plan >"$work/current.json"
    jq -e --argjson candidate "$candidate" 'any(.[]; . == $candidate)' \
        "$work/current.json" >/dev/null || continue
    tag=$(printf '%s\n' "$candidate" | jq -r '.tag')
    kind=$(printf '%s\n' "$candidate" | jq -r '.kind')
    if [ "$kind" = release ]; then
        id=$(printf '%s\n' "$candidate" | jq -r '.id')
        api --method DELETE "repos/$repo/releases/$id"
    fi
    # Delete the reference only after its release was removed successfully.
    # A failed tag deletion is repaired as an orphan by a subsequent run.
    api --method DELETE "repos/$repo/git/refs/tags/$tag"
done <"$work/candidates"
