#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

# The Guix package pins this to its guile store path (guix.scm rewrites the
# line); developers can point it elsewhere with MINDE_GUILE.
GUILE=${MINDE_GUILE:-guile}

# Single derivation of every runtime path; the Scheme clients below receive
# them as arguments instead of re-deriving them. Mirrors src/runtime_dir.rs
# (sockets) and scheme/minde/status.scm (status.json).
runtime_dir=${XDG_RUNTIME_DIR:-/tmp/minde-$(id -u)}
socket_path=$runtime_dir/minde-ipc.sock
events_socket_path=$runtime_dir/minde-events.sock
if [ -n "${MINDE_STATUS_PATH:-}" ]; then
    status_path=$MINDE_STATUS_PATH
elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    status_path=$XDG_RUNTIME_DIR/minde/status.json
else
    status_path=$runtime_dir/status.json
fi

usage() {
    cat <<'EOF'
usage: mindectl eval EXPR
       mindectl check-config FILE
       mindectl query state --json
       mindectl subscribe --json
       mindectl subscribe --events
       mindectl report --output DIRECTORY
EOF
}

# Shared by every socket client: refuse a runtime directory that is not a
# private directory of the calling user, exactly like the compositor does
# before it binds (src/runtime_dir.rs), then connect.
client_prelude='
(define (connect-private path)
  (let* ((directory (dirname path))
         (st (false-if-exception (stat directory))))
    (unless (and st
                 (eq? (stat:type st) (quote directory))
                 (= (stat:uid st) (geteuid))
                 (zero? (logand (stat:perms st) #o077)))
      (format (current-error-port)
              "mindectl: runtime directory is not a private directory of uid ~a: ~a~%"
              (geteuid) directory)
      (exit 1))
    (let ((sock (socket PF_UNIX SOCK_STREAM 0)))
      (connect sock AF_UNIX path)
      sock)))
(define (unix-socket? path)
  (let ((st (false-if-exception (stat path))))
    (and st (eq? (stat:type st) (quote socket)))))'

# One request per connection, SHUT_WR framing, one datum reply. MODE is
# `scheme` for the historical eval representation and `raw` for a returned
# string such as current-state-json (displayed verbatim). A Guile boot costs
# about 20 ms here (guile -q --no-auto-compile); nothing lighter is in the
# manifest, so this stays the client.
ipc_request() {
    mode=$1
    expression=$2
    "$GUILE" -q --no-auto-compile -c "$client_prelude"'
      (let* ((args (cdr (member "--" (command-line))))
             (path (car args))
             (mode (cadr args))
             (expression (caddr args))
             (sock (connect-private path)))
        (display expression sock)
        (shutdown sock 1)
        (let ((response (read sock)))
          (close sock)
          (if (and (pair? response) (eq? (car response) (quote ok)))
              (begin
                (if (string=? mode "raw")
                    (display (cadr response))
                    (write (cadr response)))
                (newline))
              (begin
                ;; Error replies are (error KEY ARGS MESSAGE BACKTRACE); surface
                ;; the human-readable message and bounded backtrace when present,
                ;; falling back to the raw datum for any other shape.
                (if (and (pair? response) (eq? (car response) (quote error)))
                    (let ((tail (cdddr response)))
                      (format (current-error-port) "mindectl: ~a: ~s~%"
                              (cadr response) (caddr response))
                      (when (and (pair? tail) (string? (car tail))
                                 (not (string-null? (car tail))))
                        (format (current-error-port) "  ~a~%" (car tail)))
                      (when (and (pair? tail) (pair? (cdr tail))
                                 (string? (cadr tail))
                                 (not (string-null? (cadr tail))))
                        (format (current-error-port) "~a~%" (cadr tail))))
                    (format (current-error-port) "mindectl: ~s~%" response))
                (exit 1)))))' -- "$socket_path" "$mode" "$expression"
}

redacted_path() {
    case $1 in
        "$HOME"/*) printf '%s/%s\n' '~' "${1#"$HOME"/}" ;;
        "$HOME") printf '~\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

write_report() {
    output=$1
    [ ! -e "$output" ] || {
        echo "mindectl: report output already exists: $output" >&2
        exit 1
    }
    mkdir -p "$output"
    chmod 700 "$output"

    ipc_request raw '(current-state-json #:redact? #t)' >"$output/state.json"
    chmod 600 "$output/state.json"

    script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
    if [ -x "$script_dir/minde" ]; then
        version=$("$script_dir/minde" --version 2>/dev/null || printf unknown)
    elif [ -x "$script_dir/../target/debug/minde" ]; then
        version=$("$script_dir/../target/debug/minde" --version 2>/dev/null || printf unknown)
    elif command -v minde >/dev/null 2>&1; then
        version=$(minde --version 2>/dev/null || printf unknown)
    else
        version=unknown
    fi
    config=${MINDE_CONFIG:-${MINDE_INIT:-default}}
    {
        printf 'report_schema_version=1\n'
        printf 'minde=%s\n' "$version"
        printf 'kernel=%s\n' "$(uname -srvmo 2>/dev/null || printf unknown)"
        printf 'config=%s\n' "$(redacted_path "$config")"
        printf 'seat=%s\n' "${XDG_SEAT:-unknown}"
        printf 'libseat_backend=%s\n' "${LIBSEAT_BACKEND:-auto}"
        printf 'state=state.json\n'
        printf 'drm=drm.txt\n'
        printf 'recent_errors=recent-errors.log\n'
    } >"$output/report.txt"

    {
        found=false
        for device in /sys/class/drm/card[0-9]*; do
            [ -e "$device" ] || continue
            found=true
            driver=$(readlink "$device/device/driver" 2>/dev/null || true)
            printf '%s driver=%s\n' "$(basename "$device")" \
                "$(basename "${driver:-unknown}")"
        done
        $found || printf 'no DRM card visible\n'
    } >"$output/drm.txt"

    state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/minde
    {
        for log in "$state_dir/session.previous.log" \
                   "$state_dir/session.log" "$state_dir/crash.log"; do
            [ -r "$log" ] || continue
            grep -Ei 'warn|error|panic|scheme:' "$log" 2>/dev/null || true
        done
    } |
        grep -Eiv 'title|app.?id|clipboard|command|cmd=|source=' |
        tail -n 200 |
        sed "s|$HOME|~|g" >"$output/recent-errors.log"
    chmod 600 "$output"/*
    printf '%s\n' "$output"
}

command=${1:-}
case "$command" in
    eval)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        ipc_request scheme "$2"
        ;;
    check-config)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
        if [ -d "$script_dir/../scheme" ]; then
            local_modules=$(unset CDPATH; cd -- "$script_dir/../scheme" && pwd)
        else
            local_modules=
        fi
        if [ -d "$script_dir/../share/minde/scheme" ]; then
            installed_modules=$(unset CDPATH; cd -- "$script_dir/../share/minde/scheme" && pwd)
        else
            installed_modules=
        fi
        if [ -f "$local_modules/minde/config.scm" ]; then
            modules=$local_modules
        elif [ -n "$installed_modules" ] && [ -f "$installed_modules/minde/config.scm" ]; then
            modules=$installed_modules
        elif [ -n "${MINDE_SCHEME_DIR:-}" ]; then
            modules=$MINDE_SCHEME_DIR
        else
            echo "mindectl: cannot locate Scheme modules" >&2
            exit 1
        fi
        ccache=$script_dir/../lib/guile/3.0/site-ccache
        if [ -d "$ccache" ]; then
            GUILE_LOAD_COMPILED_PATH="$ccache${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"
            export GUILE_LOAD_COMPILED_PATH
        fi
        exec "$GUILE" --no-auto-compile -L "$modules" -c \
            '(use-modules (minde command-catalog) (minde config))
             (register-builtin-command-schemas!)
             (validate-configuration-file (cadr (command-line)))
             (format #t "configuration valid: ~a~%" (cadr (command-line)))' \
            "$2"
        ;;
    query)
        if [ "$#" -ne 3 ] || [ "$2" != state ] || [ "$3" != --json ]; then
            usage >&2
            exit 2
        fi
        ipc_request raw '(current-state-json)'
        ;;
    subscribe)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        case "$2" in
            --events)
                # Real-time push: stream one s-expression line per fired event
                # from the read-only event socket. Each line is the event name
                # followed by its hook payload, e.g.
                #   (new-window 42 "firefox" "org.mozilla.firefox")
                # Titles are redacted and message events suppressed while the
                # session is locked (see doc/ipc-eww.md).
                [ -S "$events_socket_path" ] || {
                    echo "mindectl: compositor event socket is unavailable" >&2
                    exit 1
                }
                exec "$GUILE" -q --no-auto-compile -c "$client_prelude"'
                  (use-modules (ice-9 rdelim))
                  (let ((sock (connect-private (cadr (member "--" (command-line))))))
                    (let loop ((line (read-line sock)))
                      (unless (eof-object? line)
                        (display line) (newline)
                        (force-output)
                        (loop (read-line sock)))))' -- "$events_socket_path"
                ;;
            --json)
                # Compatibility change-only source: re-emit status.json whenever
                # it changes, until the compositor's IPC socket disappears. The
                # current document is emitted immediately. One long-lived Guile
                # process wakes on every event-socket line (status.json is
                # republished on the same sync path that fires focus/window
                # events), plus a 2 s safety poll; without the event socket it
                # falls back to plain polling once per second (the old loop
                # forked cat+sleep five times a second). inotifywait would be
                # the direct tool, but inotify-tools is not in manifest.scm.
                [ -S "$socket_path" ] || {
                    echo "mindectl: compositor IPC socket is unavailable" >&2
                    exit 1
                }
                exec "$GUILE" -q --no-auto-compile -c "$client_prelude"'
                  (use-modules (ice-9 rdelim))
                  (let* ((args (cdr (member "--" (command-line))))
                         (ipc-path (car args))
                         (events-path (cadr args))
                         (status-path (caddr args))
                         (events (and (unix-socket? events-path)
                                      (false-if-exception
                                       (connect-private events-path))))
                         (interval (if events 2 1)))
                    (define (current-status)
                      (false-if-exception
                       (call-with-input-file status-path
                         (lambda (port)
                           (let ((text (read-string port)))
                             (and (string? text)
                                  (not (string-null? text))
                                  (string-trim-right text #\newline)))))))
                    (define (emit-if-changed last)
                      (let ((current (current-status)))
                        (if (and current (not (equal? current last)))
                            (begin (display current) (newline) (force-output)
                                   current)
                            last)))
                    (let loop ((last (emit-if-changed #f)))
                      (when (unix-socket? ipc-path)
                        (if events
                            (let ((ready (car (select (list events) (quote ())
                                                      (quote ()) interval))))
                              (when (and (pair? ready)
                                         (eof-object? (read-line events)))
                                (exit 0))
                              (loop (emit-if-changed last)))
                            (begin
                              (sleep interval)
                              (loop (emit-if-changed last))))))))' \
                    -- "$socket_path" "$events_socket_path" "$status_path"
                ;;
            *)
                usage >&2
                exit 2
                ;;
        esac
        ;;
    report)
        if [ "$#" -ne 3 ] || [ "$2" != --output ]; then
            usage >&2
            exit 2
        fi
        write_report "$3"
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
