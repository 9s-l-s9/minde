#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

# The Guix package pins this to its guile store path (guix.scm rewrites the
# line); developers can point it elsewhere with MINDE_GUILE.
GUILE=${MINDE_GUILE:-guile}

# Single derivation of every runtime path; the Scheme clients below receive
# them as arguments instead of re-deriving them. Mirrors src/runtime_dir.rs
# (sockets) and scheme/minde/status.scm (status.json).
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/minde-$(id -u)}
socket_path=$runtime_dir/minde-ipc.sock
events_socket_path=$runtime_dir/minde-events.sock
if [ -n "${MINDE_STATUS_PATH:-}" ]; then
    status_path=$MINDE_STATUS_PATH
elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    status_path=$XDG_RUNTIME_DIR/minde/status.json
else
    status_path=$runtime_dir/status.json
fi

usage() {
    cat <<'EOF'
usage: mindectl eval EXPR [--machine|--scheme|--json] [--backtrace]
       mindectl capabilities [--scheme|--json]
       mindectl help ACTION [--scheme|--json]
       mindectl search QUERY [--scheme|--json]
       mindectl query desktop|windows [--scheme|--json]
       mindectl request [--scheme|--json]
       mindectl call ACTION ARGS-DATUM [--session S --revision N --request-id ID] [--scheme|--json]
       mindectl wait ID [--session S --timeout-ms N] [--scheme|--json]
       mindectl events-since SEQUENCE [--session S] [--scheme|--json]
       mindectl watch [--scheme|--json] [--count N]
       mindectl a11y tree|find|inspect|focus|invoke|click|set-text|select WINDOW-ID [OPTIONS]
       mindectl repl
       mindectl check-config FILE [--live] [--scheme|--json]
       mindectl query state --json
       mindectl subscribe --json
       mindectl subscribe --events
       mindectl report --output DIRECTORY

--scheme/--machine preserve the complete IPC envelope; --json projects typed
control data and tags arbitrary Scheme values as {"$scheme":"..."}.
Exit codes: 0 success, 1 operation error, 2 usage error, 3 transport/observation
failure. A timeout never cancels an action; inspect its receipt before retrying.
EOF
}

client_modules() {
    script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
    if [ -f "$script_dir/../scheme/minde/control-client.scm" ]; then
        modules=$script_dir/../scheme
    elif [ -f "$script_dir/../share/minde/scheme/minde/control-client.scm" ]; then
        modules=$script_dir/../share/minde/scheme
    elif [ -n "${MINDE_SCHEME_DIR:-}" ]; then
        modules=$MINDE_SCHEME_DIR
    else
        echo "mindectl: cannot locate Scheme client modules" >&2
        exit 1
    fi
    # Installed bytecode, or the cache that `make compile-scheme` builds in a
    # checkout. Guile ignores a compiled file older than its source, so a
    # stale cache costs time but never changes behavior.
    for ccache in "$script_dir/../lib/guile/3.0/site-ccache" "$script_dir/../build/ccache"; do
        if [ -d "$ccache" ]; then
            GUILE_LOAD_COMPILED_PATH="$ccache${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"
            export GUILE_LOAD_COMPILED_PATH
            break
        fi
    done
}

control_client() {
    client_modules
    exec "$GUILE" -q --no-auto-compile -L "$modules" -c \
        '(use-modules (minde control-client))
         (exit (control-client-main (cdr (command-line))))' "$socket_path" "$@"
}

# Long-lived subscriptions use blocking sockets. Request/response commands
# use the bounded control client below. Both require a private runtime directory.
client_prelude='
(define (connect-private path)
  (let* ((directory (dirname path))
         (st (false-if-exception (stat directory))))
    (unless (and st
                 (eq? (stat:type st) (quote directory))
                 (= (stat:uid st) (geteuid))
                 (zero? (logand (stat:perms st) #o077)))
      (format (current-error-port)
              "mindectl: runtime directory is not a private directory of uid ~a: ~a~%"
              (geteuid) directory)
      (exit 1))
    (let ((sock (socket PF_UNIX SOCK_STREAM 0)))
      (connect sock AF_UNIX path)
      sock)))
(define (unix-socket? path)
  (let ((st (false-if-exception (stat path))))
    (and st (eq? (stat:type st) (quote socket)))))'

# Keep diagnostic output verbatim while sharing the control client's deadline,
# framing, runtime checks and transport exit status.
ipc_request() {
    client_modules
    "$GUILE" -q --no-auto-compile -L "$modules" -c '
      (use-modules (minde control-client))
      (let* ((args (cdr (command-line)))
             (path (car args))
             (expression (cadr args))
             (response (ipc-request path expression)))
        (if (eq? (car response) (quote ok))
            (begin
              (display (cadr response))
              (newline))
            (exit (emit-reply response (quote raw)))))' "$socket_path" "$1"
}

redacted_path() {
    case $1 in
        "$HOME"/*) printf '%s/%s\n' '~' "${1#"$HOME"/}" ;;
        "$HOME") printf '~\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

write_report() {
    output=$1
    [ ! -e "$output" ] || {
        echo "mindectl: report output already exists: $output" >&2
        exit 1
    }
    # A missing or stalled compositor must not reserve the destination with an
    # empty state file. Command substitution preserves the transport exit code.
    state=$(ipc_request '(current-state-json #:redact? #t)')
    mkdir -p -- "$(dirname -- "$output")"
    # Refuse a destination created by another process during the IPC request.
    mkdir -m 700 -- "$output"

    printf '%s\n' "$state" >"$output/state.json"
    # Hot-path timing and mirror consistency: cheap, never personal.
    ipc_request '(wm-timing-stats)' >"$output/timing.txt" 2>/dev/null || true
    ipc_request '(mirror-drift)' >"$output/drift.txt" 2>/dev/null || true
    chmod 600 "$output/state.json"

    script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
    if [ -x "$script_dir/minde" ]; then
        version=$("$script_dir/minde" --version 2>/dev/null || printf unknown)
    elif [ -x "$script_dir/../target/debug/minde" ]; then
        version=$("$script_dir/../target/debug/minde" --version 2>/dev/null || printf unknown)
    elif command -v minde >/dev/null 2>&1; then
        version=$(minde --version 2>/dev/null || printf unknown)
    else
        version=unknown
    fi
    config=${MINDE_CONFIG:-${MINDE_INIT:-default}}
    {
        printf 'report_schema_version=1\n'
        printf 'minde=%s\n' "$version"
        printf 'kernel=%s\n' "$(uname -srvmo 2>/dev/null || printf unknown)"
        printf 'config=%s\n' "$(redacted_path "$config")"
        printf 'seat=%s\n' "${XDG_SEAT:-unknown}"
        printf 'libseat_backend=%s\n' "${LIBSEAT_BACKEND:-auto}"
        printf 'state=state.json\n'
        printf 'drm=drm.txt\n'
        printf 'recent_errors=recent-errors.log\n'
        printf 'timing=timing.txt\n'
        printf 'drift=drift.txt\n'
    } >"$output/report.txt"

    {
        found=false
        for device in /sys/class/drm/card[0-9]*; do
            [ -e "$device" ] || continue
            found=true
            driver=$(readlink "$device/device/driver" 2>/dev/null || true)
            printf '%s driver=%s\n' "$(basename "$device")" \
                "$(basename "${driver:-unknown}")"
        done
        $found || printf 'no DRM card visible\n'
    } >"$output/drm.txt"

    state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/minde
    {
        for log in "$state_dir/session.previous.log" \
                   "$state_dir/session.log" "$state_dir/crash.log"; do
            [ -r "$log" ] || continue
            grep -Ei 'warn|error|panic|scheme:' "$log" 2>/dev/null || true
        done
    } |
        grep -Eiv 'title|app.?id|clipboard|command|cmd=|source=' |
        tail -n 200 |
        sed "s|$HOME|~|g" >"$output/recent-errors.log"
    chmod 600 "$output"/*
    printf '%s\n' "$output"
}

command=${1:-}
case "$command" in
    eval|capabilities|help|search|request|call|wait|events-since|watch|repl|check-config|--machine|--scheme|--json)
        control_client "$@"
        ;;
    a11y)
        shift
        helper=$(dirname -- "$0")/minde-a11y
        case ${1:-} in
            -h|--help)
                cat <<'A11Y_HELP'
usage: mindectl a11y OPERATION WINDOW-ID [OPTIONS]

tree                   List widget roles and names (--depth N).
find                   Return the unique widget and its window-relative bounds.
inspect                Read widget state, text, value and advertised actions.
focus                  Ask the widget to take keyboard focus.
invoke --action NAME   Perform an advertised action by its exact name.
click                  Activate a button or another clickable widget.
set-text --value TEXT  Replace an editable field's contents.
select --value NAME    Choose a named entry in a selection widget.

Use --role ROLE and/or --name NAME to identify a widget. Limit the search to
a subtree with --within-role ROLE and/or --within-name NAME. Use --depth N
to limit each lookup to N levels below its root.
List window IDs with: mindectl query desktop --json
A11Y_HELP
                exit 0 ;;
        esac
        [ "$#" -ge 2 ] || { usage >&2; exit 2; }
        op=$1
        id=$2
        shift 2
        case "$op" in tree|find|inspect|focus|invoke|click|set-text|select) ;; *) usage >&2; exit 2 ;; esac
        case "$id" in ''|*[!0-9]*) echo "mindectl: expected a numeric window ID" >&2; exit 2 ;; esac
        # Keep user arguments in the shell: Guile execl transliterates them in
        # the C locale. Emit the UTF-8 title followed by a newline and PID
        # so even trailing newlines in the title survive command substitution.
        client_modules
        identity=$("$GUILE" -q --no-auto-compile -L "$modules" -c '
          (use-modules (ice-9 match) (minde control-client))
          (match (cdr (command-line))
            ((path id)
             (let* ((id (string->number id))
                    (query `(if (wm-session-locked?) (quote locked)
                                (let ((title (wm-window-title ,id)))
                                  (and title (list (wm-window-pid ,id) (car title))))))
                    (reply (ipc-request path (call-with-output-string
                                               (lambda (port) (write query port))))))
               (match reply
                   (((quote error) _ ...) (exit (emit-reply reply (quote raw))))
                   (((quote ok) ((? integer? pid) (? string? title)))
                    (set-port-encoding! (current-output-port) "UTF-8")
                    (display title)
                    (newline)
                    (display pid))
                   (((quote ok) (quote locked))
                    (display "mindectl: session is locked\n" (current-error-port))
                    (exit 1))
                   (_
                    (display "mindectl: cannot resolve window identity (unknown window, PID unavailable, or incompatible compositor)\n" (current-error-port))
                    (exit 1))))))' "$socket_path" "$id")
        newline='
'
        pid=${identity##*"$newline"}
        title=${identity%"$newline"*}
        exec "$helper" "$op" "$@" "--pid=$pid" "--title=$title"
        ;;
    query)
        if [ "${2:-}" = desktop ] || [ "${2:-}" = windows ]; then
            control_client "$@"
        fi
        if [ "$#" -ne 3 ] || [ "$2" != state ] || [ "$3" != --json ]; then
            usage >&2
            exit 2
        fi
        ipc_request '(current-state-json)'
        ;;
    subscribe)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        case "$2" in
            --events)
                # Real-time push: stream one s-expression line per fired event
                # from the read-only event socket. Each line is the event name
                # followed by its hook payload, e.g.
                #   (new-window 42 "firefox" "org.mozilla.firefox")
                # Titles are redacted and message events suppressed while the
                # session is locked (see doc/ipc-eww.md).
                [ -S "$events_socket_path" ] || {
                    echo "mindectl: compositor event socket is unavailable" >&2
                    exit 1
                }
                exec "$GUILE" -q --no-auto-compile -c "$client_prelude"'
                  (use-modules (ice-9 rdelim))
                  (let ((sock (connect-private (cadr (member "--" (command-line))))))
                    (let loop ((line (read-line sock)))
                      (unless (eof-object? line)
                        (display line) (newline)
                        (force-output)
                        (loop (read-line sock)))))' -- "$events_socket_path"
                ;;
            --json)
                # Compatibility change-only source: re-emit status.json whenever
                # it changes, until the compositor's IPC socket disappears. The
                # current document is emitted immediately. One long-lived Guile
                # process wakes on every event-socket line (status.json is
                # republished on the same sync path that fires focus/window
                # events), plus a 2 s safety poll; without the event socket it
                # falls back to plain polling once per second (the old loop
                # forked cat+sleep five times a second). inotifywait would be
                # the direct tool, but inotify-tools is not in manifest.scm.
                [ -S "$socket_path" ] || {
                    echo "mindectl: compositor IPC socket is unavailable" >&2
                    exit 1
                }
                exec "$GUILE" -q --no-auto-compile -c "$client_prelude"'
                  (use-modules (ice-9 rdelim))
                  (let* ((args (cdr (member "--" (command-line))))
                         (ipc-path (car args))
                         (events-path (cadr args))
                         (status-path (caddr args))
                         (events (and (unix-socket? events-path)
                                      (false-if-exception
                                       (connect-private events-path))))
                         (interval (if events 2 1)))
                    (define (current-status)
                      (false-if-exception
                       (call-with-input-file status-path
                         (lambda (port)
                           (let ((text (read-string port)))
                             (and (string? text)
                                  (not (string-null? text))
                                  (string-trim-right text #\newline)))))))
                    (define (emit-if-changed last)
                      (let ((current (current-status)))
                        (if (and current (not (equal? current last)))
                            (begin (display current) (newline) (force-output)
                                   current)
                            last)))
                    ;; An event line arrives from the sync path, but the
                    ;; compositor writes status.json from a deferred timer
                    ;; a moment later; reading at once would re-emit the
                    ;; previous document and leave the real change to the
                    ;; safety poll.  Give the write up to 300 ms to land.
                    (define (emit-after-event last)
                      (let retry ((left 12))
                        (let ((now (emit-if-changed last)))
                          (if (or (not (eq? now last)) (zero? left))
                              now
                              (begin (usleep 25000) (retry (- left 1)))))))
                    (let loop ((last (emit-if-changed #f)))
                      (when (unix-socket? ipc-path)
                        (if events
                            (let ((ready (car (select (list events) (quote ())
                                                      (quote ()) interval))))
                              (when (and (pair? ready)
                                         (eof-object? (read-line events)))
                                (exit 0))
                              (loop (if (pair? ready)
                                        (emit-after-event last)
                                        (emit-if-changed last))))
                            (begin
                              (sleep interval)
                              (loop (emit-if-changed last))))))))' \
                    -- "$socket_path" "$events_socket_path" "$status_path"
                ;;
            *)
                usage >&2
                exit 2
                ;;
        esac
        ;;
    report)
        if [ "$#" -ne 3 ] || [ "$2" != --output ]; then
            usage >&2
            exit 2
        fi
        write_report "$3"
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
