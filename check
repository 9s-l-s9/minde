#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Predictable user-facing verification entry point. Make retains the granular
# gates used to diagnose failures and assemble integration/release checks.
set -eu

cd "$(dirname "$0")"

usage() {
    cat <<'EOF'
usage: ./check [TEST.scm ...]

With no arguments, run the fixed fast development gate: Rust format/check,
Scheme/API/configuration/keymap suites, static analysis, and documentation.

Optional maintainer modes:
  --all          bounded nested integration suite
  --release      integration, videos, package, and archive verification
  --rust-only    just Rust format/check (no Guile required; see
                 manifest-check.scm)
  --scheme-only  just the Scheme suites, static analysis, and docs (no
                 Rust/native toolchain required; see manifest-scheme.scm)

--rust-only and --scheme-only exist so scripts/ci can run them as two
parallel CI jobs in two smaller Guix environments instead of one serial job
in the full manifest.scm; together they cover exactly the no-argument
default. Prefer plain ./check for local development.
EOF
}

run_release() {
    make check-all
    make demos
    make check-demos
    make check-package
    make check-release-archives
}

rust_gate() {
    cargo fmt --all -- --check
    cargo check --locked
}

scheme_gate() {
    make check-scheme check-api check-config check-keymaps
    make check-static
    make check-docs
}

case ${1:-} in
    -h|--help)
        usage
        exit 0
        ;;
    --all)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        exec make check-all
        ;;
    --release)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        run_release
        exit 0
        ;;
    --rust-only)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        command -v cargo >/dev/null 2>&1 || {
            echo "error: cargo is required; enter: guix shell -m manifest-check.scm" >&2
            exit 127
        }
        rust_gate
        exit 0
        ;;
    --scheme-only)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        command -v guile >/dev/null 2>&1 || {
            echo "error: guile is required; enter: guix shell -m manifest-scheme.scm" >&2
            exit 127
        }
        scheme_gate
        exit 0
        ;;
    --*)
        usage >&2
        exit 2
        ;;
esac

# Explicit Scheme test paths are the shortest debugging loop.
if [ "$#" -gt 0 ]; then
    for test in "$@"; do
        case $test in
            tests/*.scm) ;;
            *) echo "error: expected a Scheme test under tests/: $test" >&2; exit 2 ;;
        esac
        [ -f "$test" ] || { echo "error: test not found: $test" >&2; exit 2; }
    done
    for test in "$@"; do
        guile --no-auto-compile -L scheme "$test"
    done
    exit 0
fi

make check-tools
rust_gate
scheme_gate
